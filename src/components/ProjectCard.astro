---
import type { Project } from '@/content/projects';
import MovaPortfolioPreview from './MovaPortfolioPreview.astro';

interface Props { project: Project; index: number; }
const { project, index } = Astro.props;
---

<article class="project-card project-card-showcase reveal" data-category={project.category} data-index={String(index + 1).padStart(2, '0')}>
  <MovaPortfolioPreview project={project} />
</article>
