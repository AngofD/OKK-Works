---
import type { Project } from '@/content/projects';
import Icon from './Icon.astro';
import ProjectVisual from './ProjectVisual.astro';

interface Props { project: Project; index: number; }
const { project, index } = Astro.props;
---

<article class="project-card reveal" data-category={project.category}>
  <a class="project-media" href={`/work/${project.slug}/`} aria-label={`View ${project.title} case study`}>
    <ProjectVisual project={project} />
    <span class="view-pill">View case <Icon name="arrow" size={16} /></span>
  </a>
  <div class="project-info">
    <p class="project-number">0{index + 1}</p>
    <div>
      <h3><a href={`/work/${project.slug}/`}>{project.title}</a></h3>
      <p>{project.summary}</p>
    </div>
    <div class="project-meta">
      <span>{project.category}</span>
      <span>{project.year}</span>
      {project.status === 'Content pending' && <span class="pending-label">Content pending</span>}
    </div>
  </div>
</article>
