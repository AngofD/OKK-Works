---
import type { Project } from '@/content/projects';
import MovaPortfolioPreview from './MovaPortfolioPreview.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article class="project-chapter project-chapter-showcase" data-category={project.category}>
  <div class="chapter-divider reveal" aria-hidden="true">
    <span>{number}</span>
  </div>

  <div class="reveal"><MovaPortfolioPreview project={project} large /></div>

  <div class="chapter-end reveal" aria-hidden="true">
    <span>{number} / завершено</span>
  </div>
</article>
