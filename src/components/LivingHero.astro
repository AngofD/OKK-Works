---
import { withBase } from '@/lib/paths';
import '@/styles/living-hero.css';
const coins = [
  { x: 52, y: 14, size: 15, delay: -1, duration: 52 },
  { x: 72, y: 2, size: 8, delay: -9, duration: 63 },
  { x: 85, y: 15, size: 3.2, delay: -7, duration: 49 },
  { x: 78, y: 22, size: 2.6, delay: -18, duration: 67 },
  { x: 92, y: 34, size: 6, delay: -8, duration: 59 },
  { x: 48, y: 42, size: 4, delay: -21, duration: 53 },
  { x: 60, y: 62, size: 2.2, delay: -6, duration: 61 },
];
---
<section class="living-hero" data-living-hero aria-labelledby="living-title">
  <div class="living-copy">
    <p class="living-eyebrow">Незалежна студія розробки</p>
    <div class="living-statement">
      <svg class="living-star" viewBox="0 0 48 48" width="42" height="42" aria-hidden="true"><path d="M24 0c4 19 5 20 24 24-19 4-20 5-24 24C20 29 19 28 0 24 19 20 20 19 24 0Z" fill="currentColor"/></svg>
      <h1 id="living-title">ВАША ІДЕЯ.<br/><span>НАША</span> РОЗРОБКА.<br/>НОВИЙ <span>ВИМІР</span><br/>ВАШОГО БІЗНЕСУ.</h1>
    </div>
    <div class="living-bottom">
      <p>Створюємо сайти, Telegram-ботів<br class="living-desktop-break"/> та автоматизацію під ваші задачі.</p>
      <div class="living-actions">
        <a class="living-button living-button-light" href={withBase('/contact/')}>Обговорити проєкт <span aria-hidden="true">↗</span></a>
        <a class="living-button living-button-outline" href={withBase('/work/')}>Наші роботи <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
  <div class="living-scene" data-living-scene>
    <div class="living-world" aria-hidden="true">
      <picture class="living-landscape"><source media="(max-width: 700px)" srcset={withBase('/assets/living-hero/landscape-wide-mobile.webp')}/><img src={withBase('/assets/living-hero/landscape-wide.webp')} width="1536" height="1024" alt="" fetchpriority="high" decoding="async" data-scene-image/></picture>
      <div class="living-fallback-orb"></div>
      <canvas class="living-canvas" data-living-canvas></canvas>
      <div class="living-orbit"><i></i><i></i><i></i></div>
      <div class="living-orbit living-orbit-inner"></div>
      {coins.map(coin => <div class="living-coin-position" style={`--x:${coin.x}%;--y:${coin.y}%;--size:${coin.size}%;--delay:${coin.delay}s;--duration:${coin.duration}s`}><div class="living-coin-float"><div class="living-coin"><div class="coin-face coin-front"><i></i><b></b></div><div class="coin-face coin-back"><i></i><b></b></div></div></div></div>)}
      <img class="living-foliage living-foliage-far" src={withBase('/assets/living-hero/foliage.webp')} width="1536" height="1024" alt="" decoding="async"/>
      <img class="living-foliage living-foliage-near" src={withBase('/assets/living-hero/foliage.webp')} width="1536" height="1024" alt="" decoding="async"/>
      <img class="living-foliage living-foliage-left" src={withBase('/assets/living-hero/foliage.webp')} width="1536" height="1024" alt="" decoding="async"/>
    </div>
    <span class="living-scene-caption" aria-hidden="true">Ідеї набувають форми.</span>
    <button class="living-motion" type="button" data-living-motion aria-label="Призупинити анімацію" aria-pressed="false" hidden><span data-motion-icon aria-hidden="true">Ⅱ</span><span data-motion-label>Пауза</span></button>
  </div>
</section>
<script>
  import { initLivingHero } from '@/lib/living-hero';
  initLivingHero();
</script>
