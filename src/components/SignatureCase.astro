---
import Icon from '@/components/Icon.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import type { Project } from '@/content/projects';
import { withBase } from '@/lib/paths';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isBooking = project.slug === 'booking-bot';
const findNote = (title: string) => project.caseNotes?.find((note) => note.title === title)?.copy ?? '';
const screenshots = project.caseScreenshots ?? [];
const config = isBooking
  ? {
      theme: 'is-booking',
      caseNumber: '03',
      eyebrow: 'Telegram / working product',
      title: 'Booking',
      accentTitle: 'Bot',
      meta: ['Service automation', 'Live product'],
      introLabel: 'Що це за продукт',
      route: ['Послуга', 'Майстер', 'Дата', 'Вільний час'],
      stageLabel: '01 / Booking flow',
      stageMeta: 'Client path / admin logic',
      ideaLabel: 'Логіка',
      ideaTitle: 'Запис без довгої переписки.',
      ideaCopy: findNote('Booking flow'),
      proof: [
        ['Задача', 'Прибрати ручне узгодження.', project.challenge],
        ['Рішення', 'Один крок — одна зрозуміла дія.', project.solution],
        ['Для команди', 'Записи й статуси залишаються під контролем.', findNote('Для команди')],
      ],
      galleryLabel: '02 / Product screens',
      galleryTitle: 'Один чат.\nЧіткий маршрут запису.',
      galleryCopy: 'Екрани показують реальний сценарій продукту: від головного меню до вибору спеціаліста, дати та доступного часу.',
      deliveryLabel: '03 / Ready to adapt',
      deliveryTitle: 'Основа, яку можна\nналаштувати під бізнес.',
      finalLabel: 'Відкрити Booking Bot у Telegram',
      contextCopy: findNote('Контекст'),
    }
  : {
      theme: 'is-obrys',
      caseNumber: '02',
      eyebrow: 'Mountain retreat / concept project',
      title: 'ОБРИС',
      accentTitle: 'Retreat',
      meta: ['Hospitality website', 'Carpathians / remote'],
      introLabel: 'Коротко про проєкт',
      route: ['Враження', 'Простір', 'Дати', 'Перебування'],
      stageLabel: '01 / Atmosphere & path',
      stageMeta: 'Desktop + mobile experience',
      ideaLabel: 'Напрям',
      ideaTitle: 'Тиша, що веде до планування подорожі.',
      ideaCopy: findNote('Візуальна система'),
      proof: [
        ['Задача', 'Зберегти відчуття місця.', project.challenge],
        ['Рішення', 'Від панорами — до конкретної дії.', project.solution],
        ['Booking UX', 'Атмосфера завершується вибором дат.', findNote('Booking UX')],
      ],
      galleryLabel: '02 / Spaces & planner',
      galleryTitle: 'Простір спочатку\nвідчувається. Потім бронюється.',
      galleryCopy: findNote('Booking UX'),
      deliveryLabel: '03 / Built as a system',
      deliveryTitle: 'Не просто галерея.\nПовний шлях гостя.',
      finalLabel: 'Подивитися ОБРИС у браузері',
      contextCopy: findNote('Showcase context'),
    };
---

<article class:list={['signature-case', config.theme]}>
  <section class="signature-board">
    <header class="signature-topline">
      <a href={withBase('/work/')}>← Усі роботи</a>
      <div><span>OKK WORKS</span><i></i><span>SELECTED CASE / {config.caseNumber}</span></div>
      <span>{project.year} / {isBooking ? 'TELEGRAM' : 'WEBSITE'}</span>
    </header>

    <div class="signature-intro">
      <div class="signature-title">
        <p class="signature-label">{config.eyebrow}</p>
        <h1>{config.title} <em>{config.accentTitle}</em></h1>
        <div class="signature-meta">{config.meta.map((item) => <span>{item}</span>)}</div>
      </div>
      <aside class="signature-brief">
        <p class="signature-label">{config.introLabel}</p>
        <p class="signature-statement">{project.portfolioStatement}</p>
        <p>{project.portfolioDescription}</p>
        <a href="#signature-details">Дивитися рішення <Icon name="arrow" size={15} /></a>
      </aside>
    </div>

    <ol class="signature-route" aria-label={isBooking ? 'Етапи запису в боті' : 'Шлях гостя на сайті'}>
      {config.route.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong></li>)}
    </ol>

    <div class="signature-stage" id="signature-details">
      <div class="signature-stage-topline"><span>{config.stageLabel}</span><span>{config.stageMeta}</span></div>
      <div class="signature-stage-grid">
        <div class="signature-stage-visual"><ProjectVisual project={project} large priority /></div>
        <aside class="signature-stage-aside">
          <div>
            <p class="signature-label">{config.ideaLabel}</p>
            <h2>{config.ideaTitle}</h2>
            <p>{config.ideaCopy}</p>
          </div>
          {project.liveUrl && <a href={project.liveUrl} target="_blank" rel="noopener noreferrer"><span>{isBooking ? 'Запустити демо-бота' : 'Відкрити live demo'}</span><Icon name="arrow" size={20} /></a>}
        </aside>
      </div>
    </div>

    <div class="signature-proof">
      {config.proof.map(([label, title, copy]) => <article><p class="signature-label">{label}</p><h3>{title}</h3><p>{copy}</p></article>)}
    </div>
  </section>

  <section class="signature-gallery" aria-labelledby={`signature-gallery-${project.slug}`}>
    <div class="signature-gallery-heading">
      <div><p class="signature-label">{config.galleryLabel}</p><h2 id={`signature-gallery-${project.slug}`}>{config.galleryTitle.split('\n').map((line, index) => <>{line}{index === 0 && <br />}</>)}</h2></div>
      <p>{config.galleryCopy}</p>
    </div>
    <div class="signature-gallery-grid">
      {screenshots.map((shot, index) => (
        <figure class:list={['signature-gallery-shot', { 'is-wide': index === 0 }]}>
          <img src={withBase(shot.src)} width={shot.width} height={shot.height} alt={shot.alt} loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </section>

  <section class="signature-delivery">
    <div class="signature-delivery-heading">
      <p class="signature-label">{config.deliveryLabel}</p>
      <h2>{config.deliveryTitle.split('\n').map((line, index) => <>{line}{index === 0 && <br />}</>)}</h2>
      <p>{project.outcome}</p>
    </div>
    <div class="signature-delivery-content">
      <div class="signature-list"><p class="signature-label">Що реалізовано</p><ul>{project.built.map((item) => <li>{item}<span>↗</span></li>)}</ul></div>
      <div class="signature-stack"><p class="signature-label">Компетенції та стек</p><div>{[...project.capabilities, ...project.technologies].map((item) => <span>{item}</span>)}</div><p>{config.contextCopy}</p></div>
      {project.liveUrl && <a class="signature-final-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer"><span>{config.finalLabel}</span><Icon name="arrow" size={22} /></a>}
    </div>
  </section>
</article>

<style>
  .signature-case {
    --case-bg: #121b17;
    --case-panel: #24302a;
    --case-paper: #e8eadf;
    --case-accent: #b8c38f;
    --case-muted: #a8b0a9;
    --case-ink: #17201a;
    color: var(--case-paper);
    background: var(--case-bg);
  }
  .signature-case.is-booking {
    --case-bg: #071722;
    --case-panel: #102c3e;
    --case-paper: #e9f6fa;
    --case-accent: #70c8ed;
    --case-muted: #9eb7c3;
    --case-ink: #0a1d29;
  }
  .signature-board { padding: 24px var(--gutter) clamp(76px, 9vw, 132px); background: radial-gradient(circle at 78% 11%, color-mix(in srgb, var(--case-accent) 14%, transparent), transparent 28rem), var(--case-bg); }
  .signature-topline { width: min(100%, 1440px); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; margin: 0 auto; padding-bottom: 20px; border-bottom: 1px solid color-mix(in srgb, var(--case-paper) 18%, transparent); color: var(--case-muted); font-size: 9px; font-weight: 720; letter-spacing: .14em; text-transform: uppercase; }
  .signature-topline > span:last-child { text-align: right; }
  .signature-topline > div { display: flex; align-items: center; gap: 12px; }
  .signature-topline i { width: 5px; height: 5px; border-radius: 50%; background: var(--case-accent); }
  .signature-topline a:hover { color: var(--case-paper); }
  .signature-intro { width: min(100%, 1440px); display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr); gap: clamp(44px, 9vw, 150px); align-items: end; margin: 0 auto; padding: clamp(104px, 13vw, 190px) 0 clamp(68px, 8vw, 112px); }
  .signature-label { color: var(--case-accent); font-size: 9px; font-weight: 740; letter-spacing: .16em; line-height: 1.3; text-transform: uppercase; }
  .signature-title h1 { display: grid; margin-top: 22px; color: var(--case-paper); font-family: var(--font-display); font-size: clamp(78px, 13vw, 194px); font-weight: 450; letter-spacing: -.09em; line-height: .72; }
  .signature-title h1 em { color: var(--case-accent); font-style: italic; }
  .is-booking .signature-title h1 { font-family: var(--font-ui); font-weight: 790; letter-spacing: -.085em; line-height: .75; }
  .is-booking .signature-title h1 em { font-style: normal; font-weight: 260; }
  .signature-meta { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 42px; color: var(--case-muted); font-size: 10px; letter-spacing: .09em; text-transform: uppercase; }
  .signature-meta span + span { padding-left: 24px; border-left: 1px solid color-mix(in srgb, var(--case-paper) 20%, transparent); }
  .signature-brief { max-width: 390px; }
  .signature-statement { margin-top: 22px; color: var(--case-paper) !important; font-family: var(--font-display); font-size: clamp(28px, 3vw, 43px) !important; letter-spacing: -.045em; line-height: 1.02 !important; }
  .is-booking .signature-statement { font-family: var(--font-ui); font-weight: 650; letter-spacing: -.04em; }
  .signature-brief > p:nth-of-type(3) { margin-top: 18px; color: var(--case-muted); font-size: 13px; line-height: 1.6; }
  .signature-brief > a { display: inline-flex; align-items: center; gap: 12px; margin-top: 30px; padding-bottom: 7px; border-bottom: 1px solid var(--case-accent); font-size: 11px; font-weight: 720; }
  .signature-brief > a svg, .signature-stage-aside > a svg, .signature-final-link svg { transition: transform var(--fast) var(--ease); }
  .signature-brief > a:hover svg, .signature-stage-aside > a:hover svg, .signature-final-link:hover svg { transform: translate(4px, -4px); }
  .signature-route { width: min(100%, 1440px); display: grid; grid-template-columns: repeat(4, 1fr); margin: 0 auto clamp(74px, 9vw, 126px); border-block: 1px solid color-mix(in srgb, var(--case-paper) 16%, transparent); }
  .signature-route li { position: relative; min-height: 92px; display: flex; align-items: flex-end; gap: 12px; padding: 18px 16px; border-right: 1px solid color-mix(in srgb, var(--case-paper) 16%, transparent); }
  .signature-route li:last-child { border-right: 0; }
  .signature-route li:not(:last-child)::after { content: ''; position: absolute; right: -4px; bottom: 24px; z-index: 1; width: 7px; height: 7px; border-radius: 50%; background: var(--case-accent); }
  .signature-route span { color: var(--case-muted); font-size: 8px; letter-spacing: .1em; }
  .signature-route strong { font-family: var(--font-display); font-size: clamp(18px, 1.8vw, 26px); font-weight: 450; }
  .is-booking .signature-route strong { font-family: var(--font-ui); font-size: clamp(15px, 1.4vw, 20px); font-weight: 700; }
  .signature-stage { width: min(100%, 1440px); margin: 0 auto; }
  .signature-stage-topline { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 14px; color: var(--case-muted); font-size: 9px; letter-spacing: .13em; text-transform: uppercase; }
  .signature-stage-grid { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(260px, .62fr); gap: 14px; }
  .is-booking .signature-stage-grid { grid-template-columns: minmax(260px, .62fr) minmax(0, 1.8fr); }
  .signature-stage-visual { min-width: 0; overflow: hidden; background: #aeb4a3; }
  .signature-stage-visual :global(.project-visual) { height: clamp(520px, 54vw, 780px); min-height: 0; aspect-ratio: auto; background: linear-gradient(145deg, #bec2b3, #647168); }
  .is-booking .signature-stage-visual { order: 2; border-radius: 24px; background: #91bdd1; }
  .is-booking .signature-stage-visual :global(.project-visual) { background: linear-gradient(145deg, #b9dbe8, #4d7891); }
  .signature-stage-visual :global(.project-browser) { top: 8%; left: 6%; width: 83%; height: 78%; border-color: color-mix(in srgb, var(--case-ink) 28%, transparent); box-shadow: 0 32px 70px color-mix(in srgb, var(--case-ink) 34%, transparent); transform: rotate(-.8deg); }
  .signature-stage-visual :global(.project-phone) { right: 5%; bottom: -4%; width: 18%; transform: rotate(3deg); }
  .signature-stage-aside { min-height: 520px; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(26px, 3vw, 44px); color: var(--case-ink); background: var(--case-paper); }
  .is-booking .signature-stage-aside { order: 1; border-radius: 24px; }
  .signature-stage-aside .signature-label { color: color-mix(in srgb, var(--case-accent) 72%, var(--case-ink)); }
  .signature-stage-aside h2 { margin-top: 22px; font-family: var(--font-display); font-size: clamp(30px, 3.2vw, 49px); font-weight: 450; letter-spacing: -.055em; line-height: .98; }
  .is-booking .signature-stage-aside h2 { font-family: var(--font-ui); font-weight: 730; letter-spacing: -.05em; }
  .signature-stage-aside div > p:last-child { margin-top: 28px; color: color-mix(in srgb, var(--case-ink) 66%, transparent); font-size: 12px; line-height: 1.65; }
  .signature-stage-aside > a { display: flex; justify-content: space-between; gap: 20px; align-items: center; padding-top: 17px; border-top: 1px solid color-mix(in srgb, var(--case-ink) 22%, transparent); font-size: 10px; font-weight: 760; letter-spacing: .08em; text-transform: uppercase; }
  .signature-proof { width: min(100%, 1440px); display: grid; grid-template-columns: repeat(3, 1fr); margin: 14px auto 0; background: var(--case-panel); }
  .signature-proof article { min-height: 294px; padding: 26px clamp(21px, 3vw, 40px) 32px; border-right: 1px solid color-mix(in srgb, var(--case-paper) 13%, transparent); }
  .signature-proof article:last-child { border-right: 0; }
  .is-booking .signature-proof { gap: 10px; background: transparent; }
  .is-booking .signature-proof article { border: 1px solid color-mix(in srgb, var(--case-paper) 13%, transparent); border-radius: 20px; background: var(--case-panel); }
  .signature-proof h3 { max-width: 300px; margin-top: 52px; font-family: var(--font-display); font-size: clamp(24px, 2.4vw, 35px); font-weight: 450; letter-spacing: -.045em; line-height: 1.02; }
  .is-booking .signature-proof h3 { font-family: var(--font-ui); font-weight: 680; }
  .signature-proof article > p:last-child { margin-top: 17px; color: var(--case-muted); font-size: 12px; line-height: 1.58; }
  .signature-gallery { padding: clamp(90px, 11vw, 164px) var(--gutter); color: var(--case-ink); background: var(--case-paper); }
  .signature-gallery-heading { width: min(100%, 1440px); display: grid; grid-template-columns: 1.25fr .75fr; gap: 40px; align-items: end; margin: 0 auto clamp(54px, 7vw, 94px); }
  .signature-gallery .signature-label, .signature-delivery .signature-label { color: color-mix(in srgb, var(--case-accent) 68%, var(--case-ink)); }
  .signature-gallery-heading h2 { margin-top: 18px; font-size: clamp(50px, 7vw, 104px); line-height: .88; }
  .is-booking .signature-gallery-heading h2 { max-width: 1000px; font-family: var(--font-ui); font-weight: 760; letter-spacing: -.07em; }
  .signature-gallery-heading > p { max-width: 410px; color: color-mix(in srgb, var(--case-ink) 66%, transparent); font-size: 13px; line-height: 1.65; }
  .signature-gallery-grid { width: min(100%, 1440px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 0 auto; }
  .signature-gallery-shot { overflow: hidden; background: var(--case-bg); }
  .signature-gallery-shot.is-wide { grid-column: 1 / -1; }
  .signature-gallery-shot img { width: 100%; height: auto; display: block; transition: transform 700ms var(--ease-out); }
  .signature-gallery-shot:hover img { transform: scale(1.022); }
  .is-booking .signature-gallery-grid { gap: 12px; }
  .is-booking .signature-gallery-shot { display: grid; place-items: center; min-height: 330px; padding: clamp(24px, 4vw, 58px); border: 1px solid color-mix(in srgb, var(--case-ink) 12%, transparent); border-radius: 24px; background: #d8ecf3; }
  .is-booking .signature-gallery-shot.is-wide { min-height: 400px; }
  .is-booking .signature-gallery-shot img { max-height: 520px; width: auto; max-width: 100%; border-radius: 10px; box-shadow: 0 24px 70px rgba(7, 23, 34, .16); }
  .signature-delivery { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(42px, 10vw, 160px); padding: clamp(90px, 11vw, 164px) var(--gutter); color: var(--case-paper); background: var(--case-bg); }
  .signature-delivery-heading, .signature-delivery-content { width: min(100%, 630px); }
  .signature-delivery-heading { justify-self: end; }
  .signature-delivery-heading h2 { margin-top: 22px; font-size: clamp(48px, 6.3vw, 94px); line-height: .9; }
  .is-booking .signature-delivery-heading h2 { font-family: var(--font-ui); font-weight: 760; letter-spacing: -.07em; }
  .signature-delivery-heading > p:last-child { max-width: 540px; margin-top: 30px; color: var(--case-muted); font-size: 13px; line-height: 1.65; }
  .signature-delivery-content { justify-self: start; padding-top: 28px; }
  .signature-list ul { margin-top: 20px; border-top: 1px solid color-mix(in srgb, var(--case-paper) 18%, transparent); }
  .signature-list li { display: flex; justify-content: space-between; gap: 24px; padding: 14px 0; border-bottom: 1px solid color-mix(in srgb, var(--case-paper) 18%, transparent); font-family: var(--font-display); font-size: clamp(19px, 2vw, 28px); line-height: 1.12; }
  .is-booking .signature-list li { font-family: var(--font-ui); font-size: clamp(17px, 1.7vw, 23px); font-weight: 620; }
  .signature-list li span { color: var(--case-accent); font-family: var(--font-ui); font-size: 13px; }
  .signature-stack { margin-top: 60px; }
  .signature-stack > div { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .signature-stack span { padding: 8px 11px; border: 1px solid color-mix(in srgb, var(--case-paper) 20%, transparent); border-radius: 999px; color: var(--case-muted); font-size: 10px; }
  .signature-stack > p:last-child { margin-top: 25px; color: var(--case-muted); font-size: 12px; line-height: 1.6; }
  .signature-final-link { display: flex; justify-content: space-between; gap: 24px; align-items: center; margin-top: 58px; padding: 20px 0; border-block: 1px solid var(--case-accent); font-size: 11px; font-weight: 740; letter-spacing: .08em; text-transform: uppercase; }
  @media (max-width: 820px) {
    .signature-topline { display: flex; justify-content: space-between; }
    .signature-topline > div { display: none; }
    .signature-intro, .signature-gallery-heading, .signature-delivery { grid-template-columns: 1fr; }
    .signature-intro { gap: 54px; padding-block: 96px 72px; }
    .signature-title h1 { font-size: clamp(68px, 20vw, 128px); }
    .signature-brief { max-width: 540px; }
    .signature-route { grid-template-columns: 1fr 1fr; }
    .signature-route li:nth-child(2) { border-right: 0; }
    .signature-route li:nth-child(-n + 2) { border-bottom: 1px solid color-mix(in srgb, var(--case-paper) 16%, transparent); }
    .signature-route li:nth-child(2)::after { display: none; }
    .signature-stage-grid { grid-template-columns: 1fr; }
    .is-booking .signature-stage-grid { grid-template-columns: 1fr; }
    .signature-stage-visual, .is-booking .signature-stage-visual { order: 1; }
    .signature-stage-aside, .is-booking .signature-stage-aside { order: 2; min-height: 0; gap: 70px; }
    .signature-stage-visual :global(.project-visual) { height: min(122vw, 570px); }
    .signature-stage-visual :global(.project-browser) { width: 87%; height: 75%; }
    .signature-stage-visual :global(.project-phone) { width: 26%; }
    .signature-proof { grid-template-columns: 1fr; }
    .signature-proof article { min-height: 0; border-right: 0; border-bottom: 1px solid color-mix(in srgb, var(--case-paper) 13%, transparent); }
    .signature-proof article:last-child { border-bottom: 0; }
    .signature-proof h3 { margin-top: 38px; }
    .signature-gallery-heading { gap: 28px; }
    .signature-gallery-grid { grid-template-columns: 1fr; }
    .signature-gallery-shot.is-wide { grid-column: auto; }
    .signature-delivery-heading { justify-self: stretch; }
    .signature-delivery-content { justify-self: stretch; padding-top: 0; }
  }
  @media (max-width: 520px) {
    .signature-board { padding-inline: 18px; }
    .signature-title h1 { font-size: clamp(62px, 22vw, 94px); }
    .signature-meta { display: grid; gap: 8px; }
    .signature-meta span + span { padding-left: 0; border-left: 0; }
    .signature-route li { min-height: 78px; padding: 14px 10px; }
    .signature-route strong { font-size: 17px; }
    .signature-stage-topline span:last-child { display: none; }
    .signature-stage-visual, .is-booking .signature-stage-visual, .signature-stage-aside, .is-booking .signature-stage-aside { border-radius: 16px; }
    .is-booking .signature-stage-visual :global(.project-browser) { top: 12%; height: auto; aspect-ratio: 16 / 10; }
    .is-booking .signature-stage-visual :global(.project-browser > img) { object-fit: contain; background: #180a20; }
    .is-booking .signature-stage-visual :global(.project-phone) { width: 32%; }
    .signature-gallery, .signature-delivery { padding-right: 18px; padding-left: 18px; }
    .is-booking .signature-gallery-shot { min-height: 230px; padding: 20px; border-radius: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .signature-gallery-shot img { transition: none; }
  }
</style>
