---
import Icon from './Icon.astro';
import StudioIcon from './StudioIcon.astro';
import { withBase, withoutBase } from '@/lib/paths';
const path = withoutBase(Astro.url.pathname);
const links = [
  { label: 'Послуги', href: '/services/' },
  { label: 'Роботи', href: '/work/' },
  { label: 'Процес', href: '/process/' },
  { label: 'Контакти', href: '/contact/' },
];
---
<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="wordmark" href={withBase('/')} aria-label="OKK Works, головна">OKK Works<span class="brand-dot" aria-hidden="true"></span></a>
    <nav class="desktop-nav" aria-label="Головна навігація">{links.map(link => <a href={withBase(link.href)} aria-current={path.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>)}</nav>
    <a class="button button-primary header-cta" href={withBase('/contact/')}>Обговорити проєкт<StudioIcon name="arrow" size={18}/></a>
    <button class="menu-toggle" type="button" aria-label="Відкрити навігацію" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle><span class="menu-open-icon"><Icon name="menu" size={24}/></span><span class="menu-close-icon"><Icon name="close" size={24}/></span></button>
    <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
      <nav aria-label="Мобільна навігація">{links.map(link => <a href={withBase(link.href)} aria-current={path.startsWith(link.href) ? 'page' : undefined}>{link.label}<StudioIcon name="arrow"/></a>)}</nav>
      <a class="button button-primary" href={withBase('/contact/')}>Обговорити проєкт<StudioIcon name="arrow"/></a>
    </div>
  </div>
</header>
