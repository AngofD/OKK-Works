---
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const home = path === '/';
const links = [
  { label: 'Work', href: '/work/' },
  { label: 'Services', href: home ? '#services' : '/#services' },
  { label: 'Process', href: home ? '#process' : '/#process' },
  { label: 'About', href: home ? '#about' : '/#about' },
  { label: 'Contact', href: '/contact/' },
];
---

<header class="site-header" data-header>
  <a class="wordmark" href="/">
    <span>OKK</span><span class="wordmark-dot"></span><span>WORKS</span>
  </a>
  <nav class="desktop-nav" aria-label="Primary navigation">
    {links.map((link) => (
      <a href={link.href} aria-current={path.startsWith(link.href) && link.href !== '/' ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  <a class="header-cta magnetic" href="/contact/">
    Start a project <Icon name="arrow" size={17} />
  </a>
  <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
    <span class="menu-open"><Icon name="menu" /></span>
    <span class="menu-close"><Icon name="close" /></span>
  </button>
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Mobile navigation">
      {links.map((link, index) => <a href={link.href}><span>0{index + 1}</span>{link.label}</a>)}
    </nav>
    <a class="button button-light" href="/contact/">Start a project <Icon name="arrow" /></a>
  </div>
</header>
