---
import type { Project } from '@/content/projects';
import { withBase } from '@/lib/paths';

interface Props {
  project: Project;
  large?: boolean;
  priority?: boolean;
}

const { project, large = false, priority = false } = Astro.props;
---

<div class:list={['project-visual', { large }]} aria-hidden="true">
  <div class="project-browser">
    <div class="browser-bar"><i></i><i></i><i></i><span>{project.displayUrl}</span></div>
    <img
      src={withBase(project.coverImage)}
      srcset={!large ? `${withBase(project.coverThumb)} 720w, ${withBase(project.coverImage)} 1440w` : undefined}
      sizes={!large ? '(max-width: 700px) 90vw, 74vw' : undefined}
      alt=""
      width="1440"
      height="900"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
  </div>
  <div class="project-phone device-frame">
    <span class="phone-side-button phone-side-button-top" aria-hidden="true"></span>
    <span class="phone-side-button phone-side-button-middle" aria-hidden="true"></span>
    <span class="phone-side-button phone-side-button-bottom" aria-hidden="true"></span>
    <div class="phone-sensor"></div>
    <div class="phone-screen">
      <img
        src={withBase(project.mobileImage)}
        srcset={!large ? `${withBase(project.mobileThumb)} 260w, ${withBase(project.mobileImage)} 390w` : undefined}
        sizes={!large ? '(max-width: 700px) 40vw, 22vw' : undefined}
        alt=""
        width="390"
        height="844"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
  <p class="project-stamp">{project.category} / {project.year}</p>
</div>
