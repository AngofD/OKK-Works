---
interface Props { kind?: string; }
const { kind = 'websites' } = Astro.props;
---
<div class={`service-diagram diagram-${kind}`} aria-hidden="true">
  {kind === 'websites' ? <svg viewBox="0 0 620 410" fill="none">
    <g stroke="#273137" stroke-width=".7"><path d="M0 80h620M0 190h620M0 300h620M70 0v410M190 0v410M310 0v410M430 0v410M550 0v410M0 370 530 0M130 410 620 60"/></g>
    <g transform="translate(75 65) skewY(10)">
      <rect width="320" height="245" rx="5" fill="#0d1215" stroke="#737e85"/>
      <path d="M0 27h320" stroke="#58636b"/><g fill="#6b7780"><circle cx="14" cy="14" r="2"/><circle cx="23" cy="14" r="2"/><circle cx="32" cy="14" r="2"/></g>
      <path d="M20 47h70m113 0h32m14 0h20m13 0h20" stroke="#737f86"/>
      <path d="M20 70h280v98H20z" fill="#141c21" stroke="#4c5a62"/>
      <path d="m132 168 70-71 65 71m-196 0 70-53 57 53" stroke="#849298" fill="#2c373e"/>
      <path d="M20 190h114m-114 9h91m-91 9h105m-105 9h66M203 191h97v31h-97z" stroke="#5b686f"/>
    </g>
    <g transform="translate(370 43) skewY(10)"><rect width="173" height="155" rx="4" fill="#0b0f12" stroke="#66737a"/><path d="M0 20h173M16 38h92m-92 16h133m-133 8h110m-110 8h125M16 86h65v52H16zM94 86h62v52H94z" stroke="#505e67"/></g>
    <g transform="translate(350 225) skewY(10)"><rect width="190" height="150" rx="4" fill="#10161b" stroke="#99a4ab"/><path d="M0 20h190M16 38h120M16 57h68v70H16zM97 57h73m-73 9h62m-62 9h73m-73 18h60m-60 9h73m-73 16h45" stroke="#64747f"/><path d="M16 138h70" stroke="#8170d8" stroke-width="2"/></g>
    <path d="M126 335v42h185m242-190h37v91" stroke="#8170d8" opacity=".5"/><circle cx="311" cy="377" r="3" fill="#8170d8"/>
  </svg> : <div class="logic-diagram"><span class="mono">{kind === 'telegram' ? 'ОДИН ДІАЛОГ. ЗРОЗУМІЛИЙ ШЛЯХ.' : kind === 'booking' ? 'ВІД ВИБОРУ ДО ПІДТВЕРДЖЕННЯ.' : kind === 'support' ? 'ПРОЄКТ ЖИВЕ ПІСЛЯ ЗАПУСКУ.' : 'ЗВ’ЯЗУЄМО ВАШІ ПРОЦЕСИ.'}</span>
    {(kind === 'telegram' ? ['Запит клієнта', 'Ваш сценарій', 'Потрібна дія'] : kind === 'booking' ? ['Послуга та майстер', 'Зручний час', 'Підтвердження'] : kind === 'support' ? ['Перевірка', 'Оновлення', 'Стабільна робота'] : ['Нова заявка', 'Обробка даних', 'Сповіщення команді']).map((label, index) => <div><i>{index === 2 ? '✓' : '·'}</i><strong>{label}</strong><span>↘</span></div>)}
  </div>}
</div>
