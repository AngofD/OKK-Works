---
import Icon from '@/components/Icon.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import type { Project } from '@/content/projects';
import { withBase } from '@/lib/paths';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const findNote = (title: string) => project.caseNotes?.find((note) => note.title === title)?.copy ?? '';
const screenshots = project.caseScreenshots ?? [];
---

<article class="mova-case">
  <section class="mova-board">
    <header class="mova-topline">
      <a href={withBase('/work/')}>← Усі роботи</a>
      <div class="mova-topline-center"><span>OKK WORKS</span><i></i><span>SELECTED CASE / 01</span></div>
      <span>2026 / WEBSITE</span>
    </header>

    <div class="mova-intro">
      <div class="mova-title-block">
        <p class="mova-kicker">Beauty studio / concept project</p>
        <h1>MOVA <em>Beauty</em></h1>
        <div class="mova-title-meta"><span>Editorial service website</span><span>Kyiv / remote</span></div>
      </div>
      <div class="mova-brief">
        <p class="mova-label">Коротко про проєкт</p>
        <p class="mova-statement">{project.portfolioStatement}</p>
        <p class="mova-description">{project.portfolioDescription}</p>
        <div class="mova-intro-actions">
          {project.liveUrl && <a class="mova-live-action" href={project.liveUrl} target="_blank" rel="noopener noreferrer"><span>Відкрити сайт</span><Icon name="arrow" size={17} /></a>}
          <a class="mova-text-link" href="#mova-details">Дивитися рішення <Icon name="arrow" size={15} /></a>
        </div>
      </div>
    </div>

    <div class="mova-stage" id="mova-details">
      <div class="mova-stage-topline"><span>01 / Visual direction</span><span>Desktop + mobile system</span></div>
      <div class="mova-stage-grid">
        <div class="mova-stage-visual"><ProjectVisual project={project} large priority /></div>
        <aside class="mova-stage-aside">
          <div class="mova-aside-copy">
            <p class="mova-label">Ідея</p>
            <h2>Спокійна естетика, яка веде до запису.</h2>
            <p>{findNote('Art direction')}</p>
          </div>
          {project.liveUrl && <a class="mova-demo-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer"><span>Відкрити live demo</span><Icon name="arrow" size={20} /></a>}
        </aside>
      </div>
    </div>

    <div class="mova-proof">
      <article><p class="mova-label">Задача</p><h3>Враження без зайвого шуму.</h3><p>{project.challenge}</p></article>
      <article><p class="mova-label">Рішення</p><h3>Вибір послуги — короткий шлях.</h3><p>{project.solution}</p></article>
      <article><p class="mova-label">Booking UX</p><h3>Від першого екрану до дії.</h3><p>{findNote('Booking experience')}</p></article>
    </div>
  </section>

  <section class="mova-gallery" aria-labelledby="mova-gallery-title">
    <div class="mova-gallery-heading"><div><p class="mova-label">02 / Screens</p><h2 id="mova-gallery-title">Один бренд.<br /><em>Кілька сценаріїв.</em></h2></div><p>{findNote('UX послуг і галереї')}</p></div>
    <div class="mova-gallery-grid">
      {screenshots.map((shot, index) => <figure class:list={['mova-gallery-shot', { 'is-wide': index === 0 }]}><img src={withBase(shot.src)} width={shot.width} height={shot.height} alt={shot.alt} loading="lazy" decoding="async" /></figure>)}
    </div>
  </section>

  <section class="mova-delivery">
    <div class="mova-delivery-heading"><p class="mova-label">03 / Built for launch</p><h2>Не просто красиво.<br /><em>Готово до розвитку.</em></h2><p>{project.outcome}</p></div>
    <div class="mova-delivery-content">
      <div class="mova-delivery-list"><p class="mova-label">Що всередині</p><ul>{project.built.slice(0, 5).map((item) => <li>{item}<span>↗</span></li>)}</ul></div>
      <div class="mova-stack"><p class="mova-label">Стек</p><div>{project.technologies.map((item) => <span>{item}</span>)}</div><p class="mova-mobile-note">{findNote('Responsive/mobile')}</p></div>
      {project.liveUrl && <a class="mova-final-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer"><span>Подивитися MOVA у браузері</span><Icon name="arrow" size={22} /></a>}
    </div>
  </section>
</article>

<style>
  .mova-case {
    --mova-ink: #1e191b;
    --mova-deep: #171315;
    --mova-panel: #2b2226;
    --mova-cream: #f1e6dd;
    --mova-blush: #dca58d;
    --mova-muted: #ad9f9a;
    color: var(--mova-cream);
    background: var(--mova-deep);
  }
  .mova-board { padding: 24px var(--gutter) clamp(72px, 9vw, 126px); background: radial-gradient(circle at 80% 13%, rgba(220, 165, 141, .11), transparent 27rem), var(--mova-deep); }
  .mova-topline { width: min(100%, 1440px); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; margin: 0 auto; padding-bottom: 20px; border-bottom: 1px solid rgba(241, 230, 221, .18); color: var(--mova-muted); font-size: 9px; font-weight: 720; letter-spacing: .14em; text-transform: uppercase; }
  .mova-topline > span:last-child { text-align: right; }
  .mova-topline a:hover { color: var(--mova-cream); }
  .mova-topline-center { display: flex; align-items: center; gap: 12px; }
  .mova-topline-center i { width: 5px; height: 5px; border-radius: 50%; background: var(--mova-blush); }
  .mova-intro { width: min(100%, 1440px); display: grid; grid-template-columns: 1.35fr .65fr; gap: clamp(38px, 9vw, 150px); align-items: end; margin: 0 auto; padding: clamp(112px, 14vw, 210px) 0 clamp(80px, 9vw, 132px); }
  .mova-kicker { color: var(--mova-blush); font-size: 10px; font-weight: 720; letter-spacing: .16em; text-transform: uppercase; }
  .mova-title-block h1 { margin-top: 25px; color: var(--mova-cream); font-family: var(--font-display); font-size: clamp(78px, 14vw, 210px); font-weight: 450; letter-spacing: -.1em; line-height: .78; }
  .mova-title-block h1 em { color: var(--mova-blush); font-style: italic; font-weight: 430; }
  .mova-title-meta { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 38px; color: var(--mova-muted); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
  .mova-title-meta span + span { padding-left: 24px; border-left: 1px solid rgba(241, 230, 221, .2); }
  .mova-label { color: var(--mova-blush); font-size: 9px; font-weight: 720; letter-spacing: .16em; line-height: 1.3; text-transform: uppercase; }
  .mova-brief { max-width: 360px; padding-bottom: 4px; }
  .mova-statement { margin-top: 22px; color: var(--mova-cream); font-family: var(--font-display); font-size: clamp(27px, 3vw, 42px); letter-spacing: -.045em; line-height: 1.02; }
  .mova-description { margin-top: 18px; color: var(--mova-muted); font-size: 13px; line-height: 1.55; }
  .mova-intro-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; margin-top: 30px; }
  .mova-live-action { display: inline-flex; align-items: center; gap: 17px; padding: 14px 17px 14px 19px; border: 1px solid var(--mova-blush); border-radius: 999px; color: var(--mova-deep); background: var(--mova-blush); font-size: 10px; font-weight: 760; letter-spacing: .08em; text-transform: uppercase; transition: background var(--fast) var(--ease), color var(--fast) var(--ease), transform var(--fast) var(--ease); }
  .mova-live-action:hover { color: var(--mova-cream); background: transparent; transform: translateY(-2px); }
  .mova-live-action svg { transition: transform var(--fast) var(--ease-out); }
  .mova-live-action:hover svg { transform: translate(3px, -3px); }
  .mova-text-link { display: inline-flex; align-items: center; gap: 12px; padding-bottom: 7px; border-bottom: 1px solid var(--mova-blush); color: var(--mova-cream); font-size: 11px; font-weight: 720; }
  .mova-text-link svg, .mova-demo-link svg, .mova-final-link svg { transition: transform var(--fast) var(--ease); }
  .mova-text-link:hover svg, .mova-demo-link:hover svg, .mova-final-link:hover svg { transform: translate(4px, -4px); }
  .mova-stage { width: min(100%, 1440px); margin: 0 auto; }
  .mova-stage-topline { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 14px; color: var(--mova-muted); font-size: 9px; letter-spacing: .13em; text-transform: uppercase; }
  .mova-stage-grid { display: grid; grid-template-columns: minmax(0, 1.85fr) minmax(250px, .6fr); gap: 14px; }
  .mova-stage-visual { min-width: 0; overflow: hidden; border-radius: 2px; background: #cdb8af; }
  .mova-stage-visual .project-visual { height: clamp(520px, 54vw, 780px); min-height: 0; aspect-ratio: auto; background: linear-gradient(145deg, #cfbbb0, #92786f); }
  .mova-stage-visual .project-browser { top: 9%; left: 6%; width: 82%; height: 77%; border-color: rgba(30, 25, 27, .28); border-radius: 12px; box-shadow: 0 32px 70px rgba(72, 46, 42, .3); transform: rotate(-1deg); }
  .mova-stage-visual .browser-bar { background: #2a2023; }
  .mova-stage-visual .browser-bar span { color: #cdb8af; }
  .mova-stage-visual .project-browser > img { background: #cdb8af; }
  .mova-stage-visual .project-phone { right: 5%; bottom: -4%; width: 17%; transform: rotate(4deg); }
  .mova-stage-visual .device-frame { border-color: #252024; box-shadow: inset 0 0 0 1px rgba(255,255,255,.16), 0 30px 54px rgba(56, 38, 38, .38); }
  .mova-stage-visual .project-stamp { color: rgba(30, 25, 27, .64); }
  .mova-stage-aside { display: flex; flex-direction: column; justify-content: space-between; min-height: 520px; padding: clamp(24px, 3vw, 42px); color: var(--mova-ink); background: var(--mova-cream); }
  .mova-stage-aside .mova-label { color: #9d6758; }
  .mova-aside-copy h2 { margin-top: 22px; font-family: var(--font-display); font-size: clamp(28px, 3.1vw, 47px); font-weight: 450; letter-spacing: -.055em; line-height: .98; }
  .mova-aside-copy > p:last-child { margin-top: 28px; color: #756763; font-size: 12px; line-height: 1.6; }
  .mova-demo-link { display: flex; justify-content: space-between; gap: 20px; align-items: center; padding-top: 16px; border-top: 1px solid rgba(30, 25, 27, .22); font-size: 10px; font-weight: 720; letter-spacing: .08em; text-transform: uppercase; }
  .mova-proof { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 14px; background: var(--mova-panel); }
  .mova-proof article { min-height: 285px; padding: 25px clamp(20px, 3vw, 38px) 30px; border-right: 1px solid rgba(241, 230, 221, .13); }
  .mova-proof article:last-child { border-right: 0; }
  .mova-proof h3 { max-width: 270px; margin-top: 55px; color: var(--mova-cream); font-family: var(--font-display); font-size: clamp(23px, 2.3vw, 33px); font-weight: 450; letter-spacing: -.04em; line-height: 1.02; }
  .mova-proof article > p:last-child { margin-top: 16px; color: var(--mova-muted); font-size: 12px; line-height: 1.55; }
  .mova-gallery { padding: clamp(88px, 11vw, 160px) var(--gutter); color: var(--mova-ink); background: var(--mova-cream); }
  .mova-gallery-heading { width: min(100%, 1440px); display: grid; grid-template-columns: 1.2fr .8fr; gap: 40px; align-items: end; margin: 0 auto clamp(52px, 7vw, 92px); }
  .mova-gallery .mova-label, .mova-delivery .mova-label { color: #9d6758; }
  .mova-gallery-heading h2 { margin-top: 18px; font-size: clamp(52px, 7vw, 106px); line-height: .88; }
  .mova-gallery-heading h2 em { color: #a36755; font-family: var(--font-display); font-weight: 450; }
  .mova-gallery-heading > p { max-width: 390px; color: #756763; font-size: 13px; line-height: 1.6; }
  .mova-gallery-grid { width: min(100%, 1440px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 0 auto; }
  .mova-gallery-shot { overflow: hidden; background: #2a2023; }
  .mova-gallery-shot.is-wide { grid-column: 1 / -1; }
  .mova-gallery-shot img { width: 100%; height: auto; display: block; transition: transform 700ms var(--ease-out); }
  .mova-gallery-shot:hover img { transform: scale(1.025); }
  .mova-delivery { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 10vw, 160px); padding: clamp(88px, 11vw, 160px) var(--gutter); color: var(--mova-cream); background: var(--mova-deep); }
  .mova-delivery-heading, .mova-delivery-content { width: min(100%, 620px); }
  .mova-delivery-heading { justify-self: end; }
  .mova-delivery-heading h2 { margin-top: 22px; font-size: clamp(48px, 6.3vw, 94px); line-height: .9; }
  .mova-delivery-heading h2 em { color: var(--mova-blush); font-family: var(--font-display); font-weight: 450; }
  .mova-delivery-heading > p:last-child { max-width: 530px; margin-top: 30px; color: var(--mova-muted); font-size: 13px; line-height: 1.6; }
  .mova-delivery-content { justify-self: start; padding-top: 28px; }
  .mova-delivery-list ul { margin-top: 20px; border-top: 1px solid rgba(241, 230, 221, .18); }
  .mova-delivery-list li { display: flex; justify-content: space-between; gap: 24px; padding: 14px 0; border-bottom: 1px solid rgba(241, 230, 221, .18); font-family: var(--font-display); font-size: clamp(19px, 2vw, 28px); line-height: 1.12; }
  .mova-delivery-list li span { color: var(--mova-blush); font-family: var(--font-ui); font-size: 13px; }
  .mova-stack { margin-top: 62px; }
  .mova-stack > div { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .mova-stack span { padding: 8px 11px; border: 1px solid rgba(241, 230, 221, .2); border-radius: 999px; color: var(--mova-muted); font-size: 10px; }
  .mova-mobile-note { margin-top: 25px; color: var(--mova-muted); font-size: 12px; line-height: 1.55; }
  .mova-final-link { display: flex; justify-content: space-between; gap: 24px; align-items: center; margin-top: 60px; padding: 20px 0; border-block: 1px solid var(--mova-blush); color: var(--mova-cream); font-size: 11px; font-weight: 720; letter-spacing: .08em; text-transform: uppercase; }
  @media (max-width: 800px) {
    .mova-topline { display: flex; justify-content: space-between; }
    .mova-topline-center { display: none; }
    .mova-intro, .mova-gallery-heading, .mova-delivery { grid-template-columns: 1fr; }
    .mova-intro { gap: 55px; padding-block: 100px 76px; }
    .mova-title-block h1 { font-size: clamp(70px, 20vw, 130px); }
    .mova-brief { max-width: 500px; }
    .mova-intro-actions { align-items: flex-start; flex-direction: column; }
    .mova-stage-grid { grid-template-columns: 1fr; }
    .mova-stage-visual .project-visual { height: min(122vw, 560px); }
    .mova-stage-visual .project-browser { width: 86%; height: 75%; }
    .mova-stage-visual .project-phone { width: 25%; }
    .mova-stage-aside { min-height: 0; gap: 70px; }
    .mova-proof { grid-template-columns: 1fr; }
    .mova-proof article { min-height: 0; border-right: 0; border-bottom: 1px solid rgba(241, 230, 221, .13); }
    .mova-proof article:last-child { border-bottom: 0; }
    .mova-proof h3 { margin-top: 38px; }
    .mova-gallery-heading { gap: 28px; }
    .mova-gallery-grid { grid-template-columns: 1fr; }
    .mova-gallery-shot.is-wide { grid-column: auto; }
    .mova-delivery-heading { justify-self: stretch; }
    .mova-delivery-content { justify-self: stretch; padding-top: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mova-gallery-shot img { transition: none; }
  }
</style>
