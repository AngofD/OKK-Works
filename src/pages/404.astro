---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---
<BaseLayout title="Сторінку не знайдено">
  <section class="not-found"><p class="eyebrow">Помилка / 404</p><h1>Не той поворот.<br/><span>Корисний вихід.</span></h1><p>Сторінка не існує або була переміщена. Поверніться на головну або перегляньте роботи.</p><a class="button button-primary" href="/">На головну <Icon name="arrow" /></a></section>
</BaseLayout>
