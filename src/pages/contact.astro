---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/content/site';
---

<BaseLayout title="Обговорити проєкт" description="Розкажіть OKK Works про сайт, Telegram-бот або систему автоматизації для вашого бізнесу.">
  <section class="contact-page">
    <h1>Зробімо так,<span>щоб працювало.</span></h1>
    <div class="contact-grid">
      <div class="contact-direct">
        <p class="eyebrow">Зручніше email?</p>
        <a href={`mailto:${site.email}`}>{site.email}<Icon name="arrow" /></a>
        <p class="contact-note">Не потрібен ідеальний бриф. Достатньо описати проблему, поточну ситуацію та бажаний результат.</p>
      </div>
      <form class="inquiry-form" data-inquiry-form>
        <div class="form-row"><div class="field"><label for="name">Ваше ім’я</label><input id="name" name="name" autocomplete="name" required /></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div></div>
        <div class="form-row"><div class="field"><label for="service">Що потрібно?</label><select id="service" name="service" required><option value="">Оберіть послугу</option><option>Сайт</option><option>Telegram-бот</option><option>Бізнес-автоматизація</option><option>Поки не впевнений / не впевнена</option></select></div><div class="field"><label for="budget">Орієнтовний бюджет</label><select id="budget" name="budget"><option value="">Не хочу вказувати</option><option>До $2,000</option><option>$2,000-$5,000</option><option>$5,000-$10,000</option><option>$10,000+</option></select></div></div>
        <div class="field"><label for="message">Контекст проєкту</label><textarea id="message" name="message" placeholder="Що має працювати краще?" required></textarea></div>
        <div class="form-status" role="status" aria-live="polite" data-form-status></div>
        <button class="button button-primary" type="submit">Підготувати email <Icon name="arrow" /></button>
      </form>
    </div>
  </section>
</BaseLayout>
