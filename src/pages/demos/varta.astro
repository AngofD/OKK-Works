  <footer class="v-footer">
    <a class="v-mark" href="#top"><span class="v-mark-box" aria-hidden="true"><i></i><i></i></span><strong>VARTA<span>//07</span></strong><small>barber bureau</small></a>
    <p>Демонстраційна концепція · не є сайтом реального закладу</p>
    <a href="https://okkworks.com/" rel="noreferrer">Concept by OKK Works ↗</a>
  </footer>

  <dialog class="v-service-dialog" data-service-dialog aria-labelledby="service-dialog-title">
    <div class="v-dialog-bar"><span data-service-code>SVC-01 / DETAILS</span><button type="button" data-service-close aria-label="Закрити">×</button></div>
    <div class="v-service-dialog-body">
      <header><p>SERVICE PROTOCOL</p><h2 id="service-dialog-title" data-service-title>Чоловічі стрижки</h2><p data-service-lead></p></header>
      <div class="v-service-list" data-service-list></div>
      <button class="v-book v-book-large" type="button" data-dialog-book>Обрати послугу <i aria-hidden="true">↗</i></button>
    </div>
  </dialog>

  <dialog class="v-booking-dialog" data-booking-dialog aria-labelledby="booking-title">
    <div class="v-dialog-bar"><span>BOOKING / DEMO FLOW</span><button type="button" data-booking-close aria-label="Закрити">×</button></div>
    <div class="v-booking-layout">
      <aside>
        <p>BOOKING SIGNAL</p>
        <h2 id="booking-title">Зберіть<br /><em>свій візит.</em></h2>
        <ol><li class="is-current" data-booking-step-dot="0">01 / Послуга</li><li data-booking-step-dot="1">02 / Час</li><li data-booking-step-dot="2">03 / Контакт</li></ol>
        <small>Це демонстрація: дані не надсилаються та не зберігаються.</small>
      </aside>
      <div class="v-booking-stage">
        <section data-booking-step="0">
          <p class="v-stage-count">STEP 01 / 03</p><h3>Що робимо?</h3>
          <div class="v-booking-options">
            {services.map((service) => <button type="button" data-book-service={service.id}><span><strong>{service.title}</strong><small>{service.lead}</small></span><b>{service.price}</b></button>)}
          </div>
          <button class="v-next" type="button" data-booking-next disabled>Далі <span>→</span></button>
        </section>
        <section data-booking-step="1" hidden>
          <p class="v-stage-count">STEP 02 / 03</p><h3>Коли зручно?</h3>
          <div class="v-days"><button type="button" data-book-day="Сьогодні"><small>Сьогодні</small><strong>06</strong><span>Нд</span></button><button type="button" data-book-day="Завтра"><small>Завтра</small><strong>07</strong><span>Пн</span></button><button type="button" data-book-day="Вівторок"><small>Вівторок</small><strong>08</strong><span>Вт</span></button></div>
          <div class="v-times"><button type="button" disabled>10:00 <small>busy</small></button><button type="button" data-book-time="12:40">12:40 <small>free</small></button><button type="button" data-book-time="15:20">15:20 <small>free</small></button><button type="button" data-book-time="18:20">18:20 <small>free</small></button><button type="button" data-book-time="19:10">19:10 <small>free</small></button></div>
          <div class="v-stage-actions"><button type="button" data-booking-back>Назад</button><button class="v-next" type="button" data-booking-next disabled>Далі <span>→</span></button></div>
        </section>
        <section data-booking-step="2" hidden>
          <p class="v-stage-count">STEP 03 / 03</p><h3>Як із вами зв’язатися?</h3>
          <form data-booking-form novalidate>
            <label>Ім’я<input type="text" name="name" autocomplete="name" minlength="2" required placeholder="Ваше ім’я" /><span data-error="name"></span></label>
            <label>Телефон або Telegram<input type="text" name="contact" minlength="5" required placeholder="+380… або @username" /><span data-error="contact"></span></label>
            <label class="v-consent"><input type="checkbox" name="consent" required /><span>Розумію, що це демонстрація і заявка нікуди не надсилається.</span></label>
            <div class="v-book-summary"><span data-book-summary-service>—</span><span data-book-summary-time>—</span></div>
            <div class="v-stage-actions"><button type="button" data-booking-back>Назад</button><button class="v-next" type="submit">Сформувати запис <span>→</span></button></div>
          </form>
        </section>
        <section class="v-book-success" data-booking-success hidden tabindex="-1" aria-live="polite">
          <p class="v-stage-count">DEMO / COMPLETE</p><h3>Запис сформовано.</h3><p>У реальному проєкті адміністратор отримав би заявку та підтвердив вибраний час.</p><button class="v-next" type="button" data-booking-reset>Почати знову <span>↺</span></button>
        </section>
      </div>
    </div>
  </dialog>

  <script>
    type Service = {
      id: string;
      code: string;
      title: string;
      en: string;
      lead: string;
      price: string;
      items: string[][];
    };

    const root = document.documentElement;
    const qs = <T extends Element = HTMLElement>(selector: string, scope: ParentNode = document) => scope.querySelector<T>(selector);
    const qsa = <T extends Element = HTMLElement>(selector: string, scope: ParentNode = document) => [...scope.querySelectorAll<T>(selector)];
    const translations: Record<string, string> = {
      'Про нас': 'About',
      'Послуги': 'Services',
      'Команда': 'Team',
      'Контакти': 'Contacts',
      'Записатися': 'Book now',
      'Обрати час': 'Choose a time',
      'Не салон на потоці.': 'Not a conveyor-belt salon.',
      'Простір / до відкриття': 'Space / before opening',
      'Процес / контроль форми': 'Process / shape control',
      'Деталь / hair art': 'Detail / hair art',
      'хвилин на візит': 'minutes per visit',
      'напрямів послуг': 'service directions',
      'щодня без вихідних': 'open every day',
      'Чоловічі стрижки': 'Men’s haircuts',
      'Форма, що працює і після виходу з крісла.': 'A shape that works after you leave the chair.',
      'Борода та гоління': 'Beard & shave',
      'Чіткий контур, гарячий рушник і догляд.': 'Clean contour, hot towel and care.',
      'Комплекси': 'Service sets',
      'Стрижка й борода в одному візиті без поспіху.': 'Haircut and beard in one unhurried visit.',
      'Догляд': 'Care',
      'Чиста шкіра, свіжа форма та зрозумілий домашній догляд.': 'Clean skin, fresh shape and clear home care.',
      'Тонування': 'Toning',
      'Контроль сивини та кольору без різкого ефекту.': 'Grey and colour control without a harsh effect.',
      'Графічні лінії та акценти, спроєктовані під форму.': 'Graphic lines and accents designed around the shape.',
      'від 900 ₴': 'from ₴900',
      'від 650 ₴': 'from ₴650',
      'від 1 450 ₴': 'from ₴1,450',
      'від 450 ₴': 'from ₴450',
      'від 800 ₴': 'from ₴800',
      'від 500 ₴': 'from ₴500',
      '45 хв': '45 min',
      '60 хв': '60 min',
      '75 хв': '75 min',
      '40 хв': '40 min',
      '50 хв': '50 min',
      '30 хв': '30 min',
      '90 хв': '90 min',
      '100 хв': '100 min',
      '110 хв': '110 min',
      '35 хв': '35 min',
      '25 хв': '25 min',
      '70 хв': '70 min',
      'Стрижка машинкою': 'Clipper cut',
      'Класична стрижка': 'Classic haircut',
      'Довге волосся / нова форма': 'Long hair / new shape',
      'Моделювання бороди': 'Beard shaping',
      'Королівське гоління': 'Royal shave',
      'Камуфлювання бороди': 'Beard toning',
      'Стрижка + борода': 'Haircut + beard',
      'Стрижка + гоління': 'Haircut + shave',
      'Повний образ + догляд': 'Full look + care',
      'Очищення шкіри голови': 'Scalp cleansing',
      'Догляд за обличчям': 'Face care',
      'Укладка та консультація': 'Styling and consultation',
      'Камуфлювання сивини': 'Grey blending',
      'Тонування волосся': 'Hair toning',
      'Освітлення деталей': 'Detail lightening',
      'Одна графічна лінія': 'Single graphic line',
      'Авторський патерн': 'Custom pattern',
      'Патерн + оновлення форми': 'Pattern + shape refresh',
      'Детальніше про hair art': 'Explore hair art',
      'Спробувати запис': 'Try booking',
      'Послуга': 'Service',
      'Оберіть потрібну процедуру та одразу побачте вартість.': 'Choose a service and see the price immediately.',
      'Майстер і час': 'Barber and time',
      'Покажемо спеціалізацію команди та вільні вікна.': 'See each barber’s focus and available slots.',
      'Підтвердження': 'Confirmation',
      'Залиште контакт — адміністратор підтвердить візит.': 'Leave a contact and the administrator confirms the visit.',
      'Оберіть спеціалізацію, яка відповідає вашій задачі.': 'Choose the expertise that fits your goal.',
      'Класичні форми · ножиці': 'Classic shapes · scissors',
      'Fade · борода · камуфляж': 'Fade · beard · blending',
      'Довге волосся · texture': 'Long hair · texture',
      'Сьогодні · 18:20': 'Today · 18:20',
      'Завтра · 12:40': 'Tomorrow · 12:40',
      'Сьогодні · 19:10': 'Today · 19:10',
      'Обрати майстра': 'Choose barber',
      'Обрати майстра ↗': 'Choose barber ↗',
      'Замість вигаданих відгуків — конкретні правила сервісу.': 'Specific service rules instead of invented reviews.',
      'Ціну': 'Price',
      'Повна вартість відома до підтвердження запису.': 'The full price is clear before booking confirmation.',
      'Час': 'Time',
      'Тривалість закладена в слот — майстер не працює поспіхом.': 'The slot includes the full service time — no rushed work.',
      'Результат': 'Result',
      'Перед початком узгоджуємо форму та спосіб укладки.': 'We agree on the shape and styling before starting.',
      'Адреса': 'Address',
      'Графік': 'Hours',
      'Зв’язок': 'Contact',
      'Соціальні': 'Social',
      'Щодня': 'Daily',
      'Київ · демонстраційна адреса': 'Kyiv · demonstration address',
      'Обрати вільний час': 'Choose an available time',
      'Демонстраційна концепція · не є сайтом реального закладу': 'Demonstration concept · not a real venue website',
      'Закрити': 'Close',
      'Обрати послугу': 'Choose service',
      'Зберіть': 'Build',
      'свій візит.': 'your visit.',
      'Це демонстрація: дані не надсилаються та не зберігаються.': 'This is a demo: data is not sent or stored.',
      '01 / Послуга': '01 / Service',
      '02 / Час': '02 / Time',
      '03 / Контакт': '03 / Contact',
      'Що робимо?': 'What are we doing?',
      'Далі': 'Next',
      'Коли зручно?': 'When works for you?',
      'Сьогодні': 'Today',
      'Завтра': 'Tomorrow',
      'Вівторок': 'Tuesday',
      'Нд': 'Sun',
      'Пн': 'Mon',
      'Вт': 'Tue',
      'Назад': 'Back',
      'Як із вами зв’язатися?': 'How can we contact you?',
      'Ім’я': 'Name',
      'Телефон або Telegram': 'Phone or Telegram',
      'Розумію, що це демонстрація і заявка нікуди не надсилається.': 'I understand this is a demo and the request is not sent.',
      'Сформувати запис': 'Create booking',
      'Запис сформовано.': 'Booking created.',
      'У реальному проєкті адміністратор отримав би заявку та підтвердив вибраний час.': 'In a real project, the administrator would receive the request and confirm the selected time.',
      'Почати знову': 'Start again',
      'Почати знову ↺': 'Start again ↺',
    };
    const originalText = new WeakMap<Text, string>();
    let activeLang = 'uk';
    const translateTree = (scope: Node = document.body) => {
      const walker = document.createTreeWalker(scope, NodeFilter.SHOW_TEXT);
      let node = walker.nextNode() as Text | null;
      while (node) {
        const original = originalText.get(node) ?? node.textContent ?? '';
        originalText.set(node, original);
        const key = original.trim();
        const translated = translations[key];
        node.textContent = activeLang === 'en' && translated ? original.replace(key, translated) : original;
        node = walker.nextNode() as Text | null;
      }
    };

    const menu = qs<HTMLDialogElement>('[data-menu]');
    qs('[data-menu-open]')?.addEventListener('click', () => menu?.showModal());
    qsa('[data-menu-close], [data-menu] a').forEach((node) => node.addEventListener('click', () => menu?.close()));
    menu?.addEventListener('click', (event: MouseEvent) => { if (event.target === menu) menu.close(); });

    const themeButton = qs('[data-theme-toggle]');
    themeButton?.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      const label = qs('.v-theme-copy');
      if (label) label.textContent = next === 'light' ? 'DARK' : 'LIGHT';
    });

    qsa('[data-lang]').forEach((button) => button.addEventListener('click', () => {
      const lang = button.dataset.lang;
      activeLang = lang === 'en' ? 'en' : 'uk';
      root.lang = lang === 'en' ? 'en' : 'uk';
      qsa('[data-lang]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      qsa('[data-copy-ua]').forEach((node) => {
        const copy = lang === 'en' ? node.dataset.copyEn : node.dataset.copyUa;
        if (copy) node.innerHTML = copy;
      });
      translateTree();
    }));

    const header = qs('[data-header]');
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
    updateHeader();
    addEventListener('scroll', updateHeader, { passive: true });

    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); revealObserver.unobserve(entry.target); } });
    }, { threshold: 0.12 });
    qsa('[data-reveal]').forEach((node) => revealObserver.observe(node));

    const gallery = qs('[data-gallery]')!;
    const gallerySlides = qsa('[data-slide]', gallery);
    let galleryIndex = 0;
    const showGallery = (next: number) => {
      galleryIndex = (next + gallerySlides.length) % gallerySlides.length;
      gallerySlides.forEach((slide, index) => slide.classList.toggle('is-active', index === galleryIndex));
      const counter = qs('[data-gallery-current]', gallery);
      if (counter) counter.textContent = String(galleryIndex + 1).padStart(2, '0');
    };
    qs('[data-gallery-prev]', gallery)?.addEventListener('click', () => showGallery(galleryIndex - 1));
    qs('[data-gallery-next]', gallery)?.addEventListener('click', () => showGallery(galleryIndex + 1));

    const teamTrack = qs('[data-team-track]')!;
    const people = qsa('[data-person]', teamTrack);
    let teamIndex = 0;
    const scrollPerson = (next: number) => {
      teamIndex = (next + people.length) % people.length;
      people[teamIndex]?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', inline: 'start', block: 'nearest' });
      const count = qs('[data-team-count]');
      if (count) count.textContent = `${String(teamIndex + 1).padStart(2, '0')} / ${String(people.length).padStart(2, '0')}`;
    };
    qs('[data-team-prev]')?.addEventListener('click', () => scrollPerson(teamIndex - 1));
    qs('[data-team-next]')?.addEventListener('click', () => scrollPerson(teamIndex + 1));

    const services = JSON.parse(qs('main')?.dataset.services || '[]') as Service[];
    const serviceDialog = qs<HTMLDialogElement>('[data-service-dialog]')!;
    let activeService: Service = services[0];
    const openService = (id: string | undefined) => {
      activeService = services.find((service: Service) => service.id === id) || services[0];
      qs('[data-service-code]')!.textContent = `${activeService.code} / DETAILS`;
      qs('[data-service-title]')!.textContent = activeService.title;
      qs('[data-service-lead]')!.textContent = activeService.lead;
      qs('[data-service-list]')!.innerHTML = activeService.items.map((item: string[], index: number) => `<div><span>0${index + 1}</span><strong>${item[0]}</strong><small>${item[1]}</small><b>${item[2]}</b></div>`).join('');
      translateTree(serviceDialog);
      serviceDialog.showModal();
    };
    qsa('[data-service]').forEach((button) => button.addEventListener('click', () => openService(button.dataset.service)));
    qs('[data-service-close]')?.addEventListener('click', () => serviceDialog?.close());
    serviceDialog?.addEventListener('click', (event: MouseEvent) => { if (event.target === serviceDialog) serviceDialog.close(); });

    const bookingDialog = qs<HTMLDialogElement>('[data-booking-dialog]')!;
    const bookingSteps = qsa<HTMLElement>('[data-booking-step]', bookingDialog);
    const state: { step: number; service: string; day: string; time: string; barber: string } = { step: 0, service: '', day: '', time: '', barber: '' };
    const showStep = (step: number) => {
      state.step = step;
      bookingSteps.forEach((panel, index) => panel.hidden = index !== step);
      qsa('[data-booking-step-dot]', bookingDialog).forEach((dot, index) => dot.classList.toggle('is-current', index === step));
      qs<HTMLElement>('[data-booking-success]', bookingDialog)!.hidden = true;
      qs('h3', bookingSteps[step])?.focus?.();
    };
    const chooseService = (id: string | undefined) => {
      state.service = id || '';
      qsa<HTMLButtonElement>('[data-book-service]', bookingDialog).forEach((button) => button.classList.toggle('is-selected', button.dataset.bookService === id));
      qs<HTMLButtonElement>('[data-booking-step="0"] [data-booking-next]', bookingDialog)!.disabled = false;
    };
    const openBooking = (serviceId = '') => {
      menu?.close?.();
      serviceDialog?.close?.();
      if (serviceId) chooseService(serviceId);
      showStep(state.service ? 1 : 0);
      bookingDialog.showModal();
    };
    qsa('[data-open-booking]').forEach((button) => button.addEventListener('click', () => { state.barber = button.dataset.barber || ''; openBooking(); }));
    qsa<HTMLButtonElement>('[data-book-service]', bookingDialog).forEach((button) => button.addEventListener('click', () => chooseService(button.dataset.bookService)));
    qs('[data-dialog-book]')?.addEventListener('click', () => openBooking(activeService.id));
    qs('[data-booking-close]')?.addEventListener('click', () => bookingDialog?.close());
    bookingDialog?.addEventListener('click', (event: MouseEvent) => { if (event.target === bookingDialog) bookingDialog.close(); });

    qsa('[data-book-day]', bookingDialog).forEach((button) => button.addEventListener('click', () => {
      state.day = button.dataset.bookDay || '';
      qsa('[data-book-day]', bookingDialog).forEach((item) => item.classList.toggle('is-selected', item === button));
      qs<HTMLButtonElement>('[data-booking-step="1"] [data-booking-next]', bookingDialog)!.disabled = !(state.day && state.time);
    }));
    qsa('[data-book-time]', bookingDialog).forEach((button) => button.addEventListener('click', () => {
      state.time = button.dataset.bookTime || '';
      qsa('[data-book-time]', bookingDialog).forEach((item) => item.classList.toggle('is-selected', item === button));
      qs<HTMLButtonElement>('[data-booking-step="1"] [data-booking-next]', bookingDialog)!.disabled = !(state.day && state.time);
    }));
    qsa('[data-booking-next]', bookingDialog).forEach((button) => button.addEventListener('click', () => {
      if (state.step === 1) {
        const service = services.find((item: Service) => item.id === state.service);
        qs('[data-book-summary-service]')!.textContent = service ? (activeLang === 'en' ? service.en : service.title) : '—';
        qs('[data-book-summary-time]')!.textContent = `${state.day} · ${state.time}${state.barber ? ` · ${state.barber}` : ''}`;
      }
      showStep(Math.min(state.step + 1, 2));
    }));
    qsa('[data-booking-back]', bookingDialog).forEach((button) => button.addEventListener('click', () => showStep(Math.max(state.step - 1, 0))));

    qs<HTMLFormElement>('[data-booking-form]', bookingDialog)?.addEventListener('submit', (event: SubmitEvent) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const name = form.elements.namedItem('name') as HTMLInputElement;
      const contact = form.elements.namedItem('contact') as HTMLInputElement;
      const consent = form.elements.namedItem('consent') as HTMLInputElement;
      qs('[data-error="name"]', form)!.textContent = name.value.trim().length >= 2 ? '' : 'Вкажіть ім’я';
      qs('[data-error="contact"]', form)!.textContent = contact.value.trim().length >= 5 ? '' : 'Вкажіть телефон або Telegram';
      if (name.value.trim().length < 2 || contact.value.trim().length < 5 || !consent.checked) { if (!consent.checked) consent.focus(); return; }
      bookingSteps.forEach((panel) => panel.hidden = true);
      qsa('[data-booking-step-dot]', bookingDialog).forEach((dot) => dot.classList.remove('is-current'));
      const success = qs<HTMLElement>('[data-booking-success]', bookingDialog)!;
      success.hidden = false;
      success.focus();
    });
    qs('[data-booking-reset]', bookingDialog)?.addEventListener('click', () => {
      state.step = 0; state.service = ''; state.day = ''; state.time = ''; state.barber = '';
      qs<HTMLFormElement>('[data-booking-form]', bookingDialog)?.reset();
      qsa('.is-selected', bookingDialog).forEach((node) => node.classList.remove('is-selected'));
      qsa<HTMLButtonElement>('[data-booking-next]', bookingDialog).forEach((button) => button.disabled = true);
      showStep(0);
    });
  </script>
</VartaDemoLayout>
