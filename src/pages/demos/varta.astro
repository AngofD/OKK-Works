---
import VartaDemoLayout from '@/layouts/VartaDemoLayout.astro';

const services = [
  {
    id: 'haircut',
    code: 'SVC-01',
    title: 'Чоловічі стрижки',
    en: 'Men’s haircuts',
    lead: 'Форма, що працює і після виходу з крісла.',
    price: 'від 900 ₴',
    items: [
      ['Стрижка машинкою', '45 хв', '900 ₴'],
      ['Класична стрижка', '60 хв', '1 100 ₴'],
      ['Довге волосся / нова форма', '75 хв', '1 400 ₴'],
    ],
  },
  {
    id: 'beard',
    code: 'SVC-02',
    title: 'Борода та гоління',
    en: 'Beard & shave',
    lead: 'Чіткий контур, гарячий рушник і догляд.',
    price: 'від 650 ₴',
    items: [
      ['Моделювання бороди', '40 хв', '650 ₴'],
      ['Королівське гоління', '50 хв', '850 ₴'],
      ['Камуфлювання бороди', '30 хв', '700 ₴'],
    ],
  },
  {
    id: 'combo',
    code: 'SVC-03',
    title: 'Комплекси',
    en: 'Service sets',
    lead: 'Стрижка й борода в одному візиті без поспіху.',
    price: 'від 1 450 ₴',
    items: [
      ['Стрижка + борода', '90 хв', '1 450 ₴'],
      ['Стрижка + гоління', '100 хв', '1 650 ₴'],
      ['Повний образ + догляд', '110 хв', '1 900 ₴'],
    ],
  },
  {
    id: 'care',
    code: 'SVC-04',
    title: 'Догляд',
    en: 'Care',
    lead: 'Чиста шкіра, свіжа форма та зрозумілий домашній догляд.',
    price: 'від 450 ₴',
    items: [
      ['Очищення шкіри голови', '30 хв', '500 ₴'],
      ['Догляд за обличчям', '35 хв', '650 ₴'],
      ['Укладка та консультація', '25 хв', '450 ₴'],
    ],
  },
  {
    id: 'color',
    code: 'SVC-05',
    title: 'Тонування',
    en: 'Toning',
    lead: 'Контроль сивини та кольору без різкого ефекту.',
    price: 'від 800 ₴',
    items: [
      ['Камуфлювання сивини', '40 хв', '800 ₴'],
      ['Тонування волосся', '50 хв', '1 100 ₴'],
      ['Освітлення деталей', '75 хв', '1 400 ₴'],
    ],
  },
  {
    id: 'art',
    code: 'SVC-06',
    title: 'Hair art',
    en: 'Hair art',
    lead: 'Графічні лінії та акценти, спроєктовані під форму.',
    price: 'від 500 ₴',
    items: [
      ['Одна графічна лінія', '25 хв', '500 ₴'],
      ['Авторський патерн', '45 хв', '900 ₴'],
      ['Патерн + оновлення форми', '70 хв', '1 300 ₴'],
    ],
  },
];

const team = [
  { name: 'Макс', role: 'Класичні форми · ножиці', crop: 'left', availability: 'Сьогодні · 18:20' },
  { name: 'Ден', role: 'Fade · борода · камуфляж', crop: 'center', availability: 'Завтра · 12:40' },
  { name: 'Лев', role: 'Довге волосся · texture', crop: 'right', availability: 'Сьогодні · 19:10' },
];
---

<VartaDemoLayout
  title="VARTA//07 Barber Bureau — демонстраційний сайт барбершопу"
  description="Демонстраційна концепція сучасного барбершопу: послуги, прозорі ціни, команда, атмосфера та зручний онлайн-запис."
>
  <header class="v-header" data-header>
    <a class="v-mark" href="#top" aria-label="VARTA//07 — на початок">
      <span class="v-mark-box" aria-hidden="true"><i></i><i></i></span>
      <strong>VARTA<span>//07</span></strong>
      <small>barber bureau</small>
    </a>

    <nav class="v-desktop-nav" aria-label="Головна навігація">
      <a href="#about" data-copy-ua="Про нас" data-copy-en="About">Про нас</a>
      <a href="#services" data-copy-ua="Послуги" data-copy-en="Services">Послуги</a>
      <a href="#team" data-copy-ua="Команда" data-copy-en="Team">Команда</a>
      <a href="#contact" data-copy-ua="Контакти" data-copy-en="Contacts">Контакти</a>
    </nav>

    <div class="v-header-tools">
      <div class="v-lang" aria-label="Мова">
        <button type="button" data-lang="uk" aria-pressed="true">UA</button>
        <span>/</span>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
      <button class="v-theme" type="button" data-theme-toggle aria-label="Змінити тему">
        <span aria-hidden="true">◐</span><span class="v-theme-copy">LIGHT</span>
      </button>
      <button class="v-book v-book-header" type="button" data-open-booking>
        <span data-copy-ua="Записатися" data-copy-en="Book now">Записатися</span><i aria-hidden="true">↗</i>
      </button>
      <button class="v-menu-trigger" type="button" data-menu-open aria-label="Відкрити меню"><span></span><span></span></button>
    </div>
  </header>

  <dialog class="v-menu" data-menu aria-label="Головне меню">
    <div class="v-menu-top">
      <span>MENU / NAV</span>
      <button type="button" data-menu-close aria-label="Закрити меню">×</button>
    </div>
    <nav aria-label="Мобільна навігація">
      <a href="#about"><span>01</span>Про нас</a>
      <a href="#services"><span>02</span>Послуги</a>
      <a href="#team"><span>03</span>Команда</a>
      <a href="#contact"><span>04</span>Контакти</a>
    </nav>
    <button class="v-book" type="button" data-open-booking>Записатися <i aria-hidden="true">↗</i></button>
  </dialog>

  <main id="main" data-services={JSON.stringify(services)}>
    <section class="v-hero" id="top" aria-labelledby="hero-title">
      <img class="v-hero-image" src="/assets/demos/varta/hero.webp" width="1672" height="941" alt="Барбер точно формує чоловічу стрижку в сучасній майстерні" fetchpriority="high" />
      <div class="v-hero-shade" aria-hidden="true"></div>
      <div class="v-scan" aria-hidden="true"></div>

      <div class="v-hero-status v-load v-load-a">
        <span class="v-online"><i></i> SYSTEM ONLINE</span>
        <span>KYIV / 50.4501° N</span>
      </div>

      <div class="v-hero-copy v-load v-load-b">
        <p data-copy-ua="Барбер-бюро · Київ" data-copy-en="Barber bureau · Kyiv">Барбер-бюро · Київ</p>
        <h1 id="hero-title" data-copy-ua="Форма.<br />Характер.<br /><em>Без шуму.</em>" data-copy-en="Shape.<br />Character.<br /><em>No noise.</em>">
          Форма.<br />Характер.<br /><em>Без шуму.</em>
        </h1>
      </div>

      <div class="v-hero-action v-load v-load-c">
        <p data-copy-ua="Точні стрижки, борода й догляд. Оберіть послугу та час — решту беремо на себе." data-copy-en="Precise cuts, beard and care. Choose a service and time — we handle the rest.">
          Точні стрижки, борода й догляд. Оберіть послугу та час — решту беремо на себе.
        </p>
        <button class="v-book v-book-large" type="button" data-open-booking>
          <span data-copy-ua="Обрати час" data-copy-en="Choose a time">Обрати час</span><i aria-hidden="true">↗</i>
        </button>
        <a href="#services" data-copy-ua="Переглянути прайс ↓" data-copy-en="View prices ↓">Переглянути прайс ↓</a>
      </div>

      <div class="v-hero-index v-load v-load-d" aria-hidden="true">
        <span>FRAME</span><strong>01</strong><small>/ 07</small>
      </div>
    </section>

    <aside class="v-signal-rail" aria-label="Швидкий запис">
      <span>BOOKING SIGNAL</span>
      <button type="button" data-open-booking aria-label="Відкрити онлайн-запис">↗</button>
    </aside>

    <div class="v-ticker" aria-hidden="true">
      <div><span>VARTA//07</span><i>PRECISION CUTS</i><span>KYIV</span><i>BEARD / CARE</i><span>10:00—21:00</span><i>VARTA//07</i><span>PRECISION CUTS</span></div>
    </div>

    <section class="v-about" id="about" aria-labelledby="about-title">
      <header class="v-section-head" data-reveal>
        <span>ABOUT / ORIGIN</span>
        <p>01 — BUREAU</p>
      </header>
      <div class="v-about-title" data-reveal>
        <p data-copy-ua="Не салон на потоці." data-copy-en="Not a conveyor-belt salon.">Не салон на потоці.</p>
        <h2 id="about-title" data-copy-ua="Місце, де форму<br />будують <em>точно.</em>" data-copy-en="A place where shape<br />is built <em>precisely.</em>">Місце, де форму<br />будують <em>точно.</em></h2>
      </div>

      <div class="v-gallery" data-gallery data-reveal>
        <div class="v-gallery-viewport">
          <figure class="is-active" data-slide="0">
            <img src="/assets/demos/varta/interior.webp" width="1672" height="941" alt="Три робочі станції VARTA з чорними кріслами та металевими поверхнями" loading="lazy" />
            <figcaption><span>IMG-001</span> Простір / до відкриття</figcaption>
          </figure>
          <figure data-slide="1">
            <img src="/assets/demos/varta/hero.webp" width="1672" height="941" alt="Майстер працює над точною формою стрижки" loading="lazy" />
            <figcaption><span>IMG-002</span> Процес / контроль форми</figcaption>
          </figure>
          <figure data-slide="2">
            <img src="/assets/demos/varta/process.webp" width="1536" height="1024" alt="Крупний план точного оформлення контуру" loading="lazy" />
            <figcaption><span>IMG-003</span> Деталь / hair art</figcaption>
          </figure>
        </div>
        <div class="v-gallery-controls">
          <p><strong data-gallery-current>01</strong> / 03</p>
          <div><button type="button" data-gallery-prev aria-label="Попереднє фото">←</button><button type="button" data-gallery-next aria-label="Наступне фото">→</button></div>
        </div>
      </div>

      <div class="v-about-copy" data-reveal>
        <p data-copy-ua="Ми починаємо не з тренду, а з вашої форми: структура волосся, звичний ритм, скільки часу ви готові витрачати на укладку." data-copy-en="We start not with a trend, but with your shape: hair structure, daily rhythm and the time you want to spend styling.">
          Ми починаємо не з тренду, а з вашої форми: структура волосся, звичний ритм, скільки часу ви готові витрачати на укладку.
        </p>
        <p data-copy-ua="До початку називаємо ціну й тривалість. Після — показуємо, як підтримувати результат без зайвих засобів." data-copy-en="Before we start, you know the price and duration. Afterward, we show how to maintain the result without unnecessary products.">
          До початку називаємо ціну й тривалість. Після — показуємо, як підтримувати результат без зайвих засобів.
        </p>
      </div>

      <dl class="v-facts" data-reveal>
        <div><dt>45—110</dt><dd>хвилин на візит</dd></div>
        <div><dt>06</dt><dd>напрямів послуг</dd></div>
        <div><dt>10—21</dt><dd>щодня без вихідних</dd></div>
      </dl>
    </section>

    <section class="v-services" id="services" aria-labelledby="services-title">
      <header class="v-section-head" data-reveal>
        <span>SERVICE / PROTOCOL</span>
        <p>02 — PRICE</p>
      </header>
      <div class="v-services-intro" data-reveal>
        <h2 id="services-title" data-copy-ua="Оберіть<br /><em>свій протокол.</em>" data-copy-en="Choose<br /><em>your protocol.</em>">Оберіть<br /><em>свій протокол.</em></h2>
        <p data-copy-ua="У кожній категорії — конкретний час, зрозуміла ціна та жодних сюрпризів після процедури." data-copy-en="Every category has a clear duration, price and no surprises after the service.">
          У кожній категорії — конкретний час, зрозуміла ціна та жодних сюрпризів після процедури.
        </p>
      </div>
      <div class="v-service-grid">
        {services.map((service, index) => (
          <button class="v-service-card" type="button" data-service={service.id} data-reveal>
            <span class="v-service-code">{service.code}</span>
            <span class="v-service-no">0{index + 1}</span>
            <strong>{service.title}</strong>
            <small>{service.lead}</small>
            <b>{service.price}</b>
            <i aria-hidden="true">↗</i>
          </button>
        ))}
      </div>
      <p class="v-demo-note">DEMO DATA — ціни та доступний час наведені для демонстрації концепції.</p>
    </section>

    <section class="v-feature" aria-labelledby="feature-title">
      <div class="v-feature-image" data-reveal>
        <img src="/assets/demos/varta/process.webp" width="1536" height="1024" alt="Майстер створює точний графічний контур машинкою та бритвою" loading="lazy" />
        <span>CRAFT FRAME / 04</span>
      </div>
      <div class="v-feature-copy" data-reveal>
        <p>HAIR ART / CONTOUR</p>
        <h2 id="feature-title" data-copy-ua="Лінія має<br /><em>причину.</em>" data-copy-en="Every line<br /><em>has a reason.</em>">Лінія має<br /><em>причину.</em></h2>
        <p data-copy-ua="Графіку будуємо разом із силуетом стрижки. Вона підкреслює форму, а не сперечається з нею." data-copy-en="Hair graphics follow the silhouette of the cut. They reinforce the shape instead of fighting it.">
          Графіку будуємо разом із силуетом стрижки. Вона підкреслює форму, а не сперечається з нею.
        </p>
        <button class="v-text-button" type="button" data-service="art">Детальніше про hair art <span>↗</span></button>
      </div>
    </section>

    <section class="v-booking-explain" aria-labelledby="booking-explain-title">
      <header class="v-section-head" data-reveal>
        <span>BOOKING / SEQUENCE</span>
        <p>03 — FLOW</p>
      </header>
      <div class="v-booking-title" data-reveal>
        <h2 id="booking-explain-title" data-copy-ua="Запис без<br /><em>зайвих повідомлень.</em>" data-copy-en="Booking without<br /><em>extra messages.</em>">Запис без<br /><em>зайвих повідомлень.</em></h2>
        <button class="v-book v-book-large" type="button" data-open-booking>Спробувати запис <i aria-hidden="true">↗</i></button>
      </div>
      <ol class="v-steps">
        <li data-reveal><span>01</span><strong>Послуга</strong><p>Оберіть потрібну процедуру та одразу побачте вартість.</p></li>
        <li data-reveal><span>02</span><strong>Майстер і час</strong><p>Покажемо спеціалізацію команди та вільні вікна.</p></li>
        <li data-reveal><span>03</span><strong>Підтвердження</strong><p>Залиште контакт — адміністратор підтвердить візит.</p></li>
      </ol>
    </section>

    <section class="v-team" id="team" aria-labelledby="team-title">
      <header class="v-section-head" data-reveal>
        <span>TEAM / STATIONS</span>
        <p>04 — PEOPLE</p>
      </header>
      <div class="v-team-title" data-reveal>
        <h2 id="team-title" data-copy-ua="Три майстри.<br /><em>Три почерки.</em>" data-copy-en="Three barbers.<br /><em>Three signatures.</em>">Три майстри.<br /><em>Три почерки.</em></h2>
        <p>Оберіть спеціалізацію, яка відповідає вашій задачі.</p>
      </div>
      <div class="v-team-track" data-team-track>
        {team.map((member, index) => (
          <article class="v-person" data-person data-reveal>
            <div class={`v-person-image v-crop-${member.crop}`}>
              <img src="/assets/demos/varta/team.webp" width="1983" height="793" alt={`Барбер ${member.name}, ${member.role}`} loading="lazy" />
              <span>STATION / 0{index + 1}</span>
            </div>
            <div class="v-person-copy">
              <p><span>0{index + 1}</span><strong>{member.name}</strong></p>
              <small>{member.role}</small>
              <b><i></i>{member.availability}</b>
              <button type="button" data-open-booking data-barber={member.name}>Обрати майстра ↗</button>
            </div>
          </article>
        ))}
      </div>
      <div class="v-team-mobile-controls">
        <button type="button" data-team-prev aria-label="Попередній майстер">←</button>
        <span data-team-count>01 / 03</span>
        <button type="button" data-team-next aria-label="Наступний майстер">→</button>
      </div>
    </section>

    <section class="v-process" aria-labelledby="process-title">
      <header class="v-section-head" data-reveal>
        <span>PROCESS / DETAILS</span>
        <p>05 — CRAFT</p>
      </header>
      <div class="v-process-title" data-reveal>
        <h2 id="process-title" data-copy-ua="Роботу видно<br /><em>у деталях.</em>" data-copy-en="Craft lives<br /><em>in the details.</em>">Роботу видно<br /><em>у деталях.</em></h2>
      </div>
      <div class="v-process-grid">
        <figure class="v-process-a" data-reveal><img src="/assets/demos/varta/hero.webp" width="1672" height="941" alt="Точна робота ножицями біля дзеркала" loading="lazy" /><figcaption>01 / SCISSOR FORM</figcaption></figure>
        <figure class="v-process-b" data-reveal><img src="/assets/demos/varta/process.webp" width="1536" height="1024" alt="Оформлення графічної лінії бритвою" loading="lazy" /><figcaption>02 / CLEAN LINE</figcaption></figure>
        <figure class="v-process-c" data-reveal><img src="/assets/demos/varta/interior.webp" width="1672" height="941" alt="Організована робоча станція майстра" loading="lazy" /><figcaption>03 / READY STATION</figcaption></figure>
        <figure class="v-process-d" data-reveal><img src="/assets/demos/varta/team.webp" width="1983" height="793" alt="Команда VARTA в робочому просторі" loading="lazy" /><figcaption>04 / THE CREW</figcaption></figure>
      </div>
    </section>

    <section class="v-notes" aria-labelledby="notes-title">
      <header class="v-section-head" data-reveal>
        <span>SERVICE / NOTES</span>
        <p>06 — STANDARD</p>
      </header>
      <div class="v-notes-title" data-reveal>
        <h2 id="notes-title" data-copy-ua="Що ви контролюєте<br /><em>до візиту.</em>" data-copy-en="What you control<br /><em>before the visit.</em>">Що ви контролюєте<br /><em>до візиту.</em></h2>
        <p>Замість вигаданих відгуків — конкретні правила сервісу.</p>
      </div>
      <div class="v-note-grid">
        <article data-reveal><span>CLIENT NOTE / A</span><strong>Ціну</strong><p>Повна вартість відома до підтвердження запису.</p></article>
        <article data-reveal><span>CLIENT NOTE / B</span><strong>Час</strong><p>Тривалість закладена в слот — майстер не працює поспіхом.</p></article>
        <article data-reveal><span>CLIENT NOTE / C</span><strong>Результат</strong><p>Перед початком узгоджуємо форму та спосіб укладки.</p></article>
      </div>
    </section>

    <section class="v-contact" id="contact" aria-labelledby="contact-title">
      <div class="v-contact-main">
        <header class="v-section-head" data-reveal>
          <span>CONTACT / LOCATION</span>
          <p>07 — VISIT</p>
        </header>
        <div class="v-contact-title" data-reveal>
          <p>КИЇВ / ЦЕНТР</p>
          <h2 id="contact-title" data-copy-ua="Зайдіть.<br /><em>Форму зробимо тут.</em>" data-copy-en="Come in.<br /><em>We shape it here.</em>">Зайдіть.<br /><em>Форму зробимо тут.</em></h2>
        </div>
        <div class="v-contact-data" data-reveal>
          <dl>
            <div><dt>Адреса</dt><dd>вул. Велика Васильківська, 00<br />Київ · демонстраційна адреса</dd></div>
            <div><dt>Графік</dt><dd>Щодня<br />10:00—21:00</dd></div>
            <div><dt>Зв’язок</dt><dd><a href="tel:+380000000000">+380 00 000 00 00</a><br /><a href="mailto:hello@varta.demo">hello@varta.demo</a></dd></div>
            <div><dt>Соціальні</dt><dd><a href="#contact">Instagram ↗</a><br /><a href="#contact">Telegram ↗</a></dd></div>
          </dl>
          <button class="v-book v-book-large" type="button" data-open-booking>Записатися <i aria-hidden="true">↗</i></button>
