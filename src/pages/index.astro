---
import HomeLayout from '@/layouts/HomeLayout.astro';
import Services from '@/components/inner/Services.astro';
import Portfolio from '@/components/inner/Portfolio.astro';
import Process from '@/components/inner/Process.astro';
import Contact from '@/components/inner/Contact.astro';
import Footer from '@/components/inner/Footer.astro';
import '@/styles/inner.css';
import { site } from '@/content/site';
import { portfolio } from '@/content/portfolio';
import { withBase } from '@/lib/paths';
const featured = [
  { id: 'obrys', slug: 'carpathian-retreat', shortLabel: 'OBRYS', category: 'Hospitality / Вебсайт' },
  { id: 'mova', slug: 'beauty-site', shortLabel: 'MOVA', category: 'Beauty / Вебсайт' },
  { id: 'kut', slug: 'kut-01', shortLabel: 'KUT/01', category: 'Barbershop / Вебсайт' },
];
const galleryItems = featured.map(item => {
  const project = portfolio.find(project => project.slug === item.slug)!;
  return { ...item, label: project.title, image: withBase('/assets/home-v2/' + item.id + '-desktop.webp'),
    description: project.summary, caseUrl: withBase('/work/' + project.slug + '/'),
    liveUrl: project.liveUrl?.startsWith('/') ? withBase(project.liveUrl) : project.liveUrl };
});
---
<HomeLayout title="Розробка сайтів, Telegram-ботів та автоматизації" image="/assets/home-v2/purple-desert.jpg">

  <a class="skip-link" href="#main">Перейти до контенту</a>
  <header class="header" id="header">
    <a class="brand" href={withBase('/')} aria-label="OKK Works — головна"><img src="/assets/home-v2/logo.svg" width="32" height="32" alt=""><span>OKK <span class="brand-light">Works</span></span></a>
    <nav class="desktop-nav" aria-label="Головна навігація">
      <a href={withBase('/services/')}>Послуги</a>
      <a href={withBase('/work/')}>Роботи</a>
      <a href={withBase('/process/')}>Процес</a>
      <a href={withBase('/contact/')}>Контакти</a>
    </nav>
    <a class="button button-dark nav-contact" href={withBase('/contact/')}><span>Обговорити проєкт</span><span class="button-circle" aria-hidden="true">↗</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Відкрити меню"><span></span><span></span></button>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Мобільна навігація" hidden>
      <a href={withBase('/services/')}>Послуги</a>
      <a href={withBase('/work/')}>Роботи</a>
      <a href={withBase('/process/')}>Процес</a>
      <a href={withBase('/contact/')}>Контакти</a>
      <a href={withBase('/contact/')}>Обговорити проєкт</a>
      <a class="mobile-email" href={`mailto:${site.email}`}>{site.email}</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" id="home" aria-labelledby="hero-title">
      <video class="hero-video" id="hero-video" autoplay muted loop playsinline preload="auto" poster="assets/purple-desert.jpg" aria-hidden="true"><source src="/assets/home-v2/purple-desert.mp4" type="video/mp4"></video>
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">Вебсайти <span>·</span> боти <span>·</span> автоматизація</p>
        <h1 id="hero-title"><span>Цифрові рішення</span><em>для вашого бізнесу.</em></h1>
        <p class="hero-description">Від першої ідеї до продуманого, зручного продукту.</p>
        <div class="hero-actions"><a class="button button-dark" href="#contact">Обговорити проєкт <span class="button-circle" aria-hidden="true">↗</span></a><a class="button button-outline" href="#work">Переглянути роботи <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="hero-bottom"><span>Дизайн. Розробка. Запуск.</span><a class="scroll-link" href="#services">Наші послуги <span aria-hidden="true">↓</span></a><button class="motion-toggle" id="motion-toggle" type="button" aria-label="Призупинити відео" aria-pressed="false"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10M13 5v10"/></svg><span>Пауза</span></button></div>
    </section>

    <Services/>
    <Portfolio>
      <details class="i-gallery"><summary>Інтерактивний огляд сайтів <span aria-hidden="true">↔</span></summary>
        <div id="portfolio-gallery" data-items={JSON.stringify(galleryItems)}></div>
        <noscript><ul>{galleryItems.map(item => <li><a href={item.caseUrl}>{item.label} — переглянути кейс</a></li>)}</ul></noscript>
      </details>
    </Portfolio>
    <Process/>
    <Contact home/>
  </main>
  <Footer/>

  <dialog id="case-dialog" class="case-dialog" aria-labelledby="dialog-title">
    <div class="dialog-toolbar"><span class="eyebrow">OKK Works / роботи</span><button class="dialog-close" type="button" aria-label="Закрити проєкт"><span aria-hidden="true">×</span></button></div>
    <div class="dialog-body"><span class="project-status">Демо-концепт</span><h2 id="dialog-title"></h2><p class="dialog-subtitle"></p><div class="dialog-visual"><img class="dialog-desktop" alt=""><div class="phone-preview dialog-phone"><img class="dialog-mobile" alt=""></div></div><div class="dialog-copy"><div><h3>Задача</h3><p class="dialog-task"></p></div><div><h3>Рішення</h3><p class="dialog-solution"></p></div></div><div class="dialog-links"><a class="button button-outline dialog-case-link">Переглянути кейс ↗</a><a class="button button-light dialog-live-link" target="_blank" rel="noopener noreferrer">Відкрити сайт ↗</a></div><div class="dialog-bottom"><p>Демонстраційний проєкт. Не створює реальних бронювань.</p><a class="button button-light dialog-inquiry" href="#contact">Обговорити схожий проєкт <span class="button-circle" aria-hidden="true">↗</span></a></div></div>
  </dialog>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
  import '@/lib/home-v2.js';
  import '@/lib/inner';
  import '@/components/home-v2/gallery.jsx';
</script>
</HomeLayout>
