---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { projects } from '@/content/projects';

const featured = projects.filter((project) => project.featured);
const services = [
  { name: 'Websites', copy: 'Turn attention into action with a clear, distinctive website built around your offer and the way customers decide.', tags: ['Brand sites', 'Landing pages', 'Product interfaces'] },
  { name: 'Telegram Bots', copy: 'Put useful services inside a channel your customers already use, from guided requests to payments and account flows.', tags: ['Customer flows', 'Payments', 'API integrations'] },
  { name: 'Automation', copy: 'Remove repetitive work and connect fragmented tools with reliable workflows your team can understand and control.', tags: ['Process mapping', 'Integrations', 'Internal tools'] },
];
---

<BaseLayout>
  <section class="hero" data-hero>
    <div class="hero-topline">
      <span class="availability">Independent digital studio</span>
      <span>Web / Bots / Automation</span>
    </div>
    <h1 class="hero-title" aria-label="Digital products that work">
      <span><span class="word"><i>Digital</i></span></span>
      <span class="title-line-2"><span class="word"><i>products</i></span></span>
      <span class="title-line-3"><span class="word"><i>that work.</i></span></span>
    </h1>
    <div class="hero-orbit" aria-hidden="true"><span></span></div>
    <div class="hero-bottom">
      <div class="scroll-note">Scroll to explore</div>
      <p class="hero-intro">OKK Works designs and builds websites, Telegram bots, and automation shaped around real business needs.</p>
      <div class="hero-actions">
        <a class="text-link" href="/work/">Selected work <Icon name="arrow" size={16} /></a>
        <a class="button button-dark magnetic" href="/contact/">Start a project <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="services" id="services">
    <SectionHeading eyebrow="What we build" index="01" title="Useful by design. Reliable by default." />
    <div class="services-layout">
      <div class="service-list" data-services>
        {services.map((service, index) => (
          <article class:list={['service-item', { active: index === 0 }]}>
            <button class="service-trigger" type="button" aria-expanded={index === 0 ? 'true' : 'false'} data-service={index}>
              <span>0{index + 1}</span><strong>{service.name}</strong><i></i>
            </button>
            <div class="service-copy"><div><p>{service.copy}</p><ul>{service.tags.map((tag) => <li>{tag}</li>)}</ul></div></div>
          </article>
        ))}
      </div>
      <div class="services-stage reveal" aria-hidden="true">
        <div class="service-scene active" data-scene="0">
          <div class="scene-label"><span>Web experience</span><span>01 / 03</span></div>
          <div class="web-window"><b>Clarity<br/>moves.</b><span>OKK / WEB</span></div>
        </div>
        <div class="service-scene" data-scene="1">
          <div class="scene-label"><span>Telegram utility</span><span>02 / 03</span></div>
          <div class="bot-phone"><div class="bot-bubble">What can we help with?</div><div class="bot-bubble accent">Start a new request</div><div class="bot-bubble">Great. Choose a service below.</div><div class="bot-buttons"><span>Website</span><span>Automation</span></div></div>
        </div>
        <div class="service-scene" data-scene="2">
          <div class="scene-label"><span>Connected operations</span><span>03 / 03</span></div>
          <div class="automation-flow"><span>Input</span><span>Logic</span><span>Output</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="selected-work" id="work">
    <div class="work-heading-row reveal"><div><p class="eyebrow">02 / Selected work</p><h2>Made to<br/>perform.</h2></div><a class="text-link" href="/work/">View all work <Icon name="arrow" /></a></div>
    {featured.map((project, index) => <ProjectCard project={project} index={index} />)}
  </section>

  <section class="value">
    <div class="value-intro reveal"><p class="eyebrow">03 / The standard</p><h2>Not just built.<br/>Thought through.</h2></div>
    <div class="value-list">
      <article class="value-row reveal"><h3>Real problems first</h3><p>We start with the business need, the user, and the constraint. Technology follows the problem, never the other way around.</p></article>
      <article class="value-row reveal"><h3>Design with intent</h3><p>Every interaction, screen, and piece of content has a job. Clarity and character work together.</p></article>
      <article class="value-row reveal"><h3>Development that lasts</h3><p>Lean architecture, clean implementation, and practical documentation create products that remain easy to run.</p></article>
      <article class="value-row reveal"><h3>Beyond the launch</h3><p>We test, release, observe, and support. A launch is a handoff to reality, not the end of the work.</p></article>
    </div>
  </section>

  <section class="process" id="process">
    <SectionHeading eyebrow="How we work" index="04" title="A clear path from idea to working product." />
    <div class="process-list" data-process><div class="process-line" aria-hidden="true"></div>
      <article class="process-step"><span>01</span><h3>Discover</h3><p>We align on the problem, audience, context, and what a useful result should look like.</p></article>
      <article class="process-step"><span>02</span><h3>Plan & Design</h3><p>We shape the experience, define the system, and remove uncertainty before expensive implementation.</p></article>
      <article class="process-step"><span>03</span><h3>Build</h3><p>Design and development move together in focused iterations, with working reviews instead of vague status reports.</p></article>
      <article class="process-step"><span>04</span><h3>Launch & Support</h3><p>We prepare the release, verify the critical paths, and stay involved where continued support creates value.</p></article>
    </div>
  </section>

  <section class="about" id="about">
    <div class="about-grid"><p class="eyebrow">05 / About</p><div class="about-copy reveal"><p>OKK Works is an independent digital development studio for focused, useful products.</p><div class="about-detail"><p>We combine product thinking, design, and engineering in one direct process. No inflated team story. No technology theatre. Just careful decisions and responsible execution.</p><a class="button" href="/contact/">Work with us <Icon name="arrow" /></a></div></div></div>
  </section>

  <section class="final-cta">
    <p class="eyebrow">Have a project in mind?</p>
    <h2>Let's build<span>something</span>that works.</h2>
    <div class="cta-bottom"><p>Tell us what needs to change, improve, or exist. We will help define the right next step.</p><a class="button button-dark magnetic" href="/contact/">Start a project <Icon name="arrow" /></a></div>
  </section>
</BaseLayout>
