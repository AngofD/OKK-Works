---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { clientFits, clientOutcomes, processSteps, services, trustPoints } from '@/content/home';
import { projects } from '@/content/projects';
import { site } from '@/content/site';
import { withBase } from '@/lib/paths';

const portfolioExamples = [
  { key: 'websites', label: 'Вебсайти', description: 'Презентація послуги, довіра до бренду й заявка.', projects: projects.filter((project) => project.category === 'Вебсайти') },
  { key: 'telegram', label: 'Telegram-боти', description: 'Запис, сценарії для клієнтів і робота без зайвих чатів.', projects: projects.filter((project) => project.category === 'Telegram') },
  { key: 'automation', label: 'Автоматизація', description: 'Рутина, заявки та сповіщення в одному робочому процесі.', projects: projects.filter((project) => project.category === 'Автоматизація') },
].filter((group) => group.projects.length > 0);
---

<BaseLayout title="Розробка сайтів, Telegram-ботів та автоматизації" preloadHero>
  <section class="hero" data-hero>
    <picture class="hero-media" aria-hidden="true">
      <source media="(max-width: 700px)" srcset={withBase('/media/hero-dawn-mobile.webp')} />
      <img src={withBase('/media/hero-dawn.webp')} width="1672" height="941" alt="" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="hero-eyebrow reveal">Незалежна студія цифрової розробки</p>
      <h1 class="hero-wordmark">OKK Works</h1>
      <ul class="hero-services" aria-label="Основні послуги">
        <li>Вебсайти</li>
        <li>Telegram-боти</li>
        <li>Автоматизація</li>
      </ul>
      <p class="hero-intro">Створюємо сайти, Telegram-боти й автоматизацію для українського бізнесу: щоб клієнтам було легше зробити крок, а команді - менше працювати вручну.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={withBase('/work/')}>Переглянути роботи <Icon name="arrow" /></a>
        <a class="button button-ghost" href={withBase('/contact/')}>Обговорити проєкт <Icon name="arrow" /></a>
      </div>
    </div>
    <div class="hero-foot">
      <span>Від ідеї до запуску</span>
      <a href="#services">Дізнатися більше <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="services" id="services" aria-labelledby="services-title" data-service-experience>
    <div class="services-intro reveal">
      <p class="eyebrow">Послуги / 01</p>
      <h2 id="services-title">Оберіть задачу.<br/><em>Побачте рішення.</em></h2>
      <p>Вибір змінює лише наступний блок. Структура сторінки й доступ до робіт залишаються незмінними.</p>
    </div>
    <div class="service-tabs" role="tablist" aria-label="Напрями роботи">
      {services.map((service, index) => (
        <button
          class:list={['service-tab', { active: index === 0 }]}
          id={`service-tab-${service.key}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`service-panel-${service.key}`}
          tabindex={index === 0 ? 0 : -1}
          data-service-tab={service.key}
        >
          <span>0{index + 1}</span>{service.label}
        </button>
      ))}
    </div>

    <div class="service-panels">
      {services.map((service, index) => {
        const related = service.projectSlugs
          .map((slug) => projects.find((project) => project.slug === slug))
          .filter((project): project is (typeof projects)[number] => Boolean(project));
        const visualProject = related[0];
        return (
          <article
            class:list={['service-panel', `service-${service.key}`, { active: index === 0 }]}
            id={`service-panel-${service.key}`}
            role="tabpanel"
            aria-labelledby={`service-tab-${service.key}`}
            data-service-panel={service.key}
            hidden={index !== 0}
          >
            <div class="service-panel-copy">
              <p class="service-panel-eyebrow">{service.eyebrow}</p>
              <p class="service-problem"><span>Задача</span>{service.problem}</p>
              <h3>{service.title}</h3>
              <p class="service-description">{service.description}</p>
              <div class="service-value"><span>Результат для бізнесу</span><p>{service.value}</p></div>
              <ul class="service-capabilities" aria-label="Що реалізуємо">{service.capabilities.map((item) => <li>{item}</li>)}</ul>
              <a class="button button-primary" href={withBase(`/contact/?service=${service.key}`)}>{service.cta} <Icon name="arrow" /></a>
            </div>
            <div class="service-visual" aria-hidden="true">
              {service.key === 'websites' && visualProject && <div class="web-scene website-project-scene"><ProjectVisual project={visualProject} /></div>}
              {service.key === 'telegram' && <div class="telegram-scene"><div class="telegram-phone"><div class="telegram-head"><i></i><span>Сервіс-бот</span><b>•••</b></div><p>Вітаємо! Що бажаєте зробити?</p><div class="telegram-choice">Забронювати послугу</div><div class="telegram-reply">Оберіть зручний день</div><div class="telegram-days"><span>Ср, 12</span><span>Чт, 13</span></div></div><p>Один чат.<br/><em>Менше кроків.</em></p></div>}
              {service.key === 'automation' && <div class="automation-scene"><p>Робочий процес</p><div class="automation-flow"><span>Заявка<small>01</small></span><i></i><span>Перевірка<small>02</small></span><i></i><span>Сповіщення<small>03</small></span><i></i><span>Готово<small>04</small></span></div><strong>Рутина рухається<br/><em>без ручного контролю.</em></strong></div>}
              {service.key === 'support' && <div class="support-scene"><div class="release-card"><p>Запуск продукту</p><ul><li><span>Домен і SSL</span><b>Готово</b></li><li><span>Production</span><b>Готово</b></li><li><span>Аналітика</span><b>Готово</b></li><li><span>Моніторинг</span><b>Активний</b></li></ul><div><i></i>Система працює стабільно</div></div><strong>Запустили.<br/><em>Залишаємося поруч.</em></strong></div>}
            </div>
            <div class="service-proof">
              <p>Пов’язана робота</p>
              {related.length > 0 ? related.map((project) => project && <a href={withBase(`/work/${project.slug}/`)}><span>{project.category}</span><strong>{project.title}</strong><Icon name="arrow" size={18} /></a>) : <p class="proof-pending">Профільний кейс опублікуємо після підготовки реальних матеріалів. Покажемо релевантний підхід під час розмови.</p>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="client-fit" aria-labelledby="client-fit-title">
    <div class="section-heading reveal">
      <div class="section-kicker"><span>02</span><p>Кому допомагаємо</p></div>
      <h2 id="client-fit-title">Коли цифровий продукт має вирішувати конкретну бізнес-задачу.</h2>
    </div>
    <div class="client-fit-grid">
      {clientFits.map((fit, index) => (
        <article class="client-fit-card reveal">
          <div class="client-fit-topline"><span>0{index + 1}</span><p>{fit.label}</p></div>
          <h3>{fit.title}</h3>
          <p>{fit.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="selected-work" id="work">
    <div class="work-heading-row reveal">
      <div><p class="eyebrow">Приклад роботи / 03</p><h2>Оберіть тип продукту.<br/><em>Подивіться релевантний кейс.</em></h2><p class="work-heading-copy">Спочатку оберіть, що потрібно вашому бізнесу. Потім подивіться готовий приклад саме такого рішення.</p></div>
      <a class="text-link" href={withBase('/work/')}>Усі роботи <Icon name="arrow" /></a>
    </div>
    <div class="portfolio-explorer" data-portfolio-explorer>
      <div class="portfolio-tabs" role="tablist" aria-label="Напрям прикладу роботи">
        {portfolioExamples.map((group, index) => (
          <button class:list={['portfolio-tab', { active: index === 0 }]} id={`portfolio-tab-${group.key}`} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`portfolio-panel-${group.key}`} tabindex={index === 0 ? 0 : -1} data-portfolio-tab={group.key}>
            <span>0{index + 1}</span><strong>{group.label}</strong><small>{group.description}</small><b>{group.projects.length.toString().padStart(2, '0')} приклади <i aria-hidden="true">↗</i></b>
          </button>
        ))}
      </div>
      <div class="portfolio-panels">
        {portfolioExamples.map((group, index) => (
          <div class:list={['portfolio-panel', { active: index === 0 }]} id={`portfolio-panel-${group.key}`} role="tabpanel" aria-labelledby={`portfolio-tab-${group.key}`} data-portfolio-panel={group.key} hidden={index !== 0}>
            <div class="portfolio-panel-label"><span>Показуємо</span><strong>{group.label}</strong><i aria-hidden="true"></i><span>{group.projects[0]?.status}</span></div>
            {group.projects.map((project, caseIndex) => <ProjectCard project={project} index={caseIndex} />)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="process" id="process">
    <SectionHeading eyebrow="Процес" index="04" title="Зрозумілий шлях від задачі до стабільного продукту." />
    <div class="process-list" data-process>
      <div class="process-line" aria-hidden="true"><span></span></div>
      {processSteps.map((step, index) => <article class="process-step reveal"><span>{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.copy}</p></article>)}
    </div>
  </section>

  <section class="about" id="about">
    <div class="about-grid">
      <p class="eyebrow">Про студію / 05</p>
      <div class="about-copy reveal">
        <h2>OKK Works - незалежна студія цифрової розробки.</h2>
        <p>Поєднуємо продуктове мислення, дизайн і розробку в одному прямому процесі. Не імітуємо велику корпорацію: уважно розбираємо задачу, показуємо роботу в процесі й відповідаємо за запуск.</p>
      </div>
    </div>
    <ul class="trust-list">{trustPoints.map((point, index) => <li class="reveal"><span>0{index + 1}</span>{point}</li>)}</ul>
  </section>

  <section class="client-outcomes" aria-labelledby="outcomes-title">
    <div class="section-heading reveal">
      <div class="section-kicker"><span>06</span><p>Що змінюється</p></div>
      <h2 id="outcomes-title">Цифровий продукт має допомагати бізнесу, а не просто виглядати добре.</h2>
    </div>
    <div class="outcomes-grid">
      {clientOutcomes.map((outcome, index) => (
        <article class="outcome-card reveal">
          <span>0{index + 1}</span>
          <h3>{outcome.title}</h3>
          <p>{outcome.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="final-cta">
    <div class="final-cta-shade" aria-hidden="true"></div>
    <div class="final-cta-content reveal">
      <p class="eyebrow">Почнімо з вашої задачі</p>
      <h2>Маєте ідею або<br/><em>бізнес-задачу?</em></h2>
      <p>Перетворімо її на цифровий продукт, який зрозумілий людям і реально працює для бізнесу.</p>
      <div class="final-actions"><a class="button button-primary" href={withBase('/contact/')}>Обговорити проєкт <Icon name="arrow" /></a><a href={`mailto:${site.email}`}>{site.email}</a>{site.telegram && <a href={site.telegram} target="_blank" rel="noreferrer">Telegram</a>}</div>
    </div>
  </section>
</BaseLayout>
