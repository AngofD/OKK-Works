---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { capabilities, processSteps, services, values } from '@/content/home';
import { projects } from '@/content/projects';

const featured = projects.filter((project) => project.featured);
---

<BaseLayout>
  <section class="hero" data-hero>
    <div class="hero-copy reveal">
      <p class="availability">Незалежна студія цифрової розробки</p>
      <h1 class="hero-title">
        <span>Сайти.</span>
        <span>Telegram-боти.</span>
        <span>Системи автоматизації.</span>
      </h1>
      <p class="hero-intro">OKK Works проєктує й розробляє цифрові системи, які допомагають бізнесу комунікувати, обслуговувати клієнтів і наводити лад в операціях.</p>
      <div class="hero-actions">
        <a class="button button-primary magnetic" href="/contact/">Обговорити проєкт <Icon name="arrow" /></a>
        <a class="button button-secondary" href="/work/">Переглянути роботи <Icon name="arrow" /></a>
      </div>
    </div>
    <div class="hero-architecture" aria-hidden="true">
      <div class="portal portal-a"></div>
      <div class="portal portal-b"></div>
      <div class="portal portal-c"></div>
      <div class="light-shaft"></div>
      <div class="system-line line-a"></div>
      <div class="system-line line-b"></div>
    </div>
  </section>

  <section class="capability-strip" aria-label="Core capabilities">
    {capabilities.map((item, index) => <a href={index === 3 ? '#process' : '#services'}><span>0{index + 1}</span>{item}</a>)}
  </section>

  <section class="services" id="services">
    <SectionHeading eyebrow="Послуги" index="01" title="Три сфокусовані напрями, щоб digital працював краще." />
    <div class="services-layout">
      <div class="service-list" data-services>
        {services.map((service, index) => (
          <article class:list={['service-item reveal', { active: index === 0 }]}>
            <button class="service-trigger" type="button" aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={`service-copy-${index}`} data-service={index}>
              <span>0{index + 1}</span><strong>{service.name}</strong><i></i>
            </button>
            <div class="service-copy" id={`service-copy-${index}`}><div><p>{service.copy}</p><ul>{service.tags.map((tag) => <li>{tag}</li>)}</ul></div></div>
          </article>
        ))}
      </div>
      <div class="services-stage reveal" aria-hidden="true">
        <div class="service-scene active" data-scene="0">
          <div class="scene-label"><span>Web experience</span><span>01 / 03</span></div>
          <div class="web-window"><b>Ясність<br/>рухає.</b><span>OKK / WEB</span></div>
        </div>
        <div class="service-scene" data-scene="1">
          <div class="scene-label"><span>Telegram-утиліта</span><span>02 / 03</span></div>
          <div class="bot-phone"><div class="bot-bubble">Чим можемо допомогти?</div><div class="bot-bubble accent">Створити заявку</div><div class="bot-bubble">Добре. Оберіть послугу нижче.</div><div class="bot-buttons"><span>Сайт</span><span>Автоматизація</span></div></div>
        </div>
        <div class="service-scene" data-scene="2">
          <div class="scene-label"><span>Connected operations</span><span>03 / 03</span></div>
          <div class="automation-flow"><span>Вхід</span><span>Логіка</span><span>Результат</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="selected-work" id="work">
    <div class="work-heading-row reveal"><div><p class="eyebrow">02 / Вибрані роботи</p><h2>Докази, не обіцянки.</h2></div><a class="text-link" href="/work/">Усі роботи <Icon name="arrow" /></a></div>
    {featured.map((project, index) => <ProjectCard project={project} index={index} />)}
  </section>

  <section class="value">
    <div class="value-intro reveal"><p class="eyebrow">03 / Чому OKK</p><h2>Незалежна студія. Дорослі рішення. Практична реалізація.</h2></div>
    <div class="value-list">
      {values.map((item) => <article class="value-row reveal"><h3>{item.title}</h3><p>{item.copy}</p></article>)}
    </div>
  </section>

  <section class="process" id="process">
    <SectionHeading eyebrow="Процес" index="04" title="Зрозумілий шлях від ідеї до продукту, який працює." />
    <div class="process-list" data-process><div class="process-line" aria-hidden="true"></div>
      {processSteps.map((step, index) => <article class="process-step"><span>{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.copy}</p></article>)}
    </div>
  </section>

  <section class="about" id="about">
    <div class="about-grid"><p class="eyebrow">05 / Про нас</p><div class="about-copy reveal"><p>OKK Works - незалежна студія цифрової розробки.</p><div class="about-detail"><p>Ми поєднуємо продуктове мислення, дизайн і engineering в одному прямому процесі. Без вигаданої історії великої команди. Без технологічного театру. Лише уважні рішення й відповідальна реалізація.</p><a class="button button-secondary" href="/contact/">Працювати з нами <Icon name="arrow" /></a></div></div></div>
  </section>

  <section class="final-cta">
    <p class="eyebrow">Є проєкт на думці?</p>
    <h2>Збудуймо те, що працює.</h2>
    <div class="cta-bottom"><p>Розкажіть, що має змінитися, покращитися або з’явитися. Ми допоможемо визначити правильний наступний крок.</p><a class="button button-primary magnetic" href="/contact/">Обговорити проєкт <Icon name="arrow" /></a></div>
  </section>
</BaseLayout>
