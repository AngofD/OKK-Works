---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StudioIcon from '@/components/StudioIcon.astro';
import { portfolio, nextPortfolioProject, projectLabel } from '@/content/portfolio';
import type { Project } from '@/content/projects';
import { withBase } from '@/lib/paths';
import { absoluteUrl, type JsonLd } from '@/lib/seo';
export function getStaticPaths() {
  return portfolio.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: Project; }
const { project } = Astro.props;
const next = nextPortfolioProject(project.slug);
const isBot = project.category === 'Telegram';
const external = project.liveUrl?.startsWith('https://');
const projectUrl = absoluteUrl(`/work/${project.slug}/`);
const visualSystem: Record<string,string> = {
  'beauty-site': 'Тепла природна палітра, виразна типографіка й фотографії з повітрям. Сайт адаптується до мобільного екрана без втрати атмосфери.',
  'carpathian-retreat': 'Гірські пейзажі, стримані кольори й великі фотографії. Контент послідовно знайомить із місцем та веде до планування перебування.',
  'kut-01': 'Графіт, метал і сигнальний синій. Табличний прайс та панель запису підкреслюють точність і спокій майстерні.',
  'booking-bot': 'Знайомий інтерфейс Telegram, короткі повідомлення й кнопки з однозначними діями. Кожен крок залишає тільки потрібний вибір.',
};
const projectSchemas: JsonLd[] = [
  { '@type': 'CreativeWork', '@id': `${projectUrl}#project`, url: projectUrl, name: project.title, headline: project.headline, description: project.summary, image: [absoluteUrl(project.coverImage),absoluteUrl(project.mobileImage)], dateCreated: project.year, inLanguage: 'uk', genre: project.category, creator: { '@id': absoluteUrl('/#organization') }, ...(project.liveUrl ? { sameAs: external ? project.liveUrl : absoluteUrl(project.liveUrl) } : {}) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type':'ListItem', position:1, name:'Головна', item:absoluteUrl('/') },
    { '@type':'ListItem', position:2, name:'Роботи', item:absoluteUrl('/work/') },
    { '@type':'ListItem', position:3, name:project.title, item:projectUrl },
  ]},
];
---
<BaseLayout title={`${project.title}: кейс ${isBot ? 'Telegram-бота' : 'вебсайту'}`} description={project.summary} image={project.coverImage} imageAlt={`${project.title} — кейс OKK Works`} imageWidth={1440} imageHeight={900} schemas={projectSchemas}>
  <article class="shell case-page">
    <a class="case-back" href={withBase('/work/')}><StudioIcon name="arrow" size={17}/>Усі роботи</a>
    <header class="case-hero"><div class="case-hero-copy"><p class="eyebrow">{projectLabel(project)} / {isBot ? 'Telegram-бот' : 'Сайт'}</p><h1>{project.title}</h1><p>{project.headline}</p>{project.liveUrl && <a class="button button-primary" href={external ? project.liveUrl : withBase(project.liveUrl)} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{isBot ? 'Відкрити бота' : 'Відкрити сайт'}<StudioIcon name="diagonal"/></a>}</div><div class:list={['case-cover',{'is-bot':isBot}]}><img src={withBase(project.coverThumb)} width="1440" height="900" alt={`${project.title}: ${isBot ? 'демонстрація бота' : 'головний екран'}`} fetchpriority="high"/></div></header>
    <section class="case-summary" aria-labelledby="case-task"><div><h2 id="case-task">Про проєкт</h2><p>{project.overview}</p></div><dl class="case-facts"><div><dt>Формат</dt><dd>{projectLabel(project)}</dd></div><div><dt>Напрям</dt><dd>{isBot ? 'Telegram-бот' : 'Вебсайт'}</dd></div><div><dt>Реалізація</dt><dd>{project.technologies.slice(0,2).join(' · ')}</dd></div><div><dt>Рік</dt><dd>{project.year}</dd></div></dl></section>
    {!isBot ? <section class={`case-preview case-${project.slug}`} aria-label="Десктопна та мобільна версії"><figure class="preview-desktop"><img src={withBase(project.coverImage)} width="1440" height="900" alt={`${project.title} — версія для комп’ютера`} loading="lazy"/><figcaption>DESKTOP / Основний екран</figcaption></figure><figure class="preview-mobile"><img src={withBase(project.mobileImage)} width="390" height="844" alt={`${project.title} — версія для телефона`} loading="lazy"/><figcaption>MOBILE / Адаптивний інтерфейс</figcaption></figure></section> : <section class="case-bot-screens" aria-label="Кроки запису в Telegram">{project.caseScreenshots?.map((shot,index)=><figure><img src={withBase(shot.src)} width={shot.width} height={shot.height} alt={shot.alt} loading="lazy"/><figcaption>0{index+1} / {['Головне меню','Вибір спеціаліста','Вибір дати','Доступний час'][index]}</figcaption></figure>)}</section>}
    <section class="case-solutions"><h2>Продумано<br/>до деталей.</h2><div><h3>Логіка та структура</h3><p>{project.solution}</p><ul>{project.built.map(item=><li>{item}</li>)}</ul></div><div><h3>Візуальна система</h3><p>{visualSystem[project.slug]}</p><h3 class="case-demo-heading">Можна спробувати</h3><p>{isBot ? 'Відкрийте демонстрацію, щоб пройти клієнтський сценарій. Функції для вашого бізнесу узгоджуємо окремо.' : 'Це демонстраційна концепція, не сайт реального клієнта. Форми запису показують сценарій, але не створюють справжніх бронювань.'}</p></div></section>
    {!isBot && project.caseScreenshots && <div class="case-detail-grid">{project.caseScreenshots.slice(0,2).map((shot,index)=><figure><img src={withBase(shot.src)} width={shot.width} height={shot.height} alt={shot.alt} loading="lazy"/><figcaption>{project.slug==='beauty-site' ? ['Послуги та вибір','Галерея робіт'][index] : ['Архітектура та простір','Галерея'][index]}</figcaption></figure>)}</div>}
    <a class="case-next" href={withBase(`/work/${next.slug}/`)}><div><span>Наступний проєкт</span><strong>{next.title}</strong></div><StudioIcon name="arrow" size={40}/></a>
  </article>
</BaseLayout>
