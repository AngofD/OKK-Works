---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import MovaCase from '@/components/MovaCase.astro';
import SignatureCase from '@/components/SignatureCase.astro';
import { getNextProject, projects, type Project } from '@/content/projects';
import { withBase } from '@/lib/paths';
import { absoluteUrl, type JsonLd } from '@/lib/seo';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: Project; }
const { project } = Astro.props;
const next = getNextProject(project.slug);
const hasDistinctNext = projects.length > 1 && next.slug !== project.slug;
const caseTitle = project.category === 'Telegram'
  ? `${project.title}: кейс Telegram-бота`
  : `${project.title}: кейс вебсайту`;
const projectUrl = absoluteUrl(`/work/${project.slug}/`);
const projectSchemas: JsonLd[] = [
  {
    '@type': 'CreativeWork',
    '@id': `${projectUrl}#project`,
    url: projectUrl,
    name: project.title,
    headline: project.headline,
    description: project.summary,
    image: [absoluteUrl(project.coverImage), absoluteUrl(project.mobileImage)],
    dateCreated: project.year,
    inLanguage: 'uk',
    genre: project.category,
    creator: { '@id': absoluteUrl('/#organization') },
    ...(project.liveUrl ? { sameAs: project.liveUrl } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Головна', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Роботи', item: absoluteUrl('/work/') },
      { '@type': 'ListItem', position: 3, name: project.title, item: projectUrl },
    ],
  },
];
---

<BaseLayout title={caseTitle} description={project.summary} image={project.coverImage} imageAlt={`${project.title} — кейс OKK Works`} imageWidth={1440} imageHeight={900} schemas={projectSchemas}>
  {project.slug === 'beauty-site' ? <MovaCase project={project} /> : <SignatureCase project={project} />}
  {hasDistinctNext ? <a class="next-project" href={withBase(`/work/${next.slug}/`)}><span>Наступний проєкт</span><div><h2>{next.title}</h2><Icon name="arrow" size={70} /></div></a> : <a class="next-project" href={withBase('/contact/')}><span>Наступний проєкт може бути вашим</span><div><h2>Обговорімо задачу</h2><Icon name="arrow" size={70} /></div></a>}
</BaseLayout>
