---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { categories, projects } from '@/content/projects';
---

<BaseLayout title="Роботи" description="Вибрані сайти, Telegram-боти та системи автоматизації від OKK Works.">
  <section class="page-hero">
    <p class="eyebrow">Вибрані проєкти / Архів</p>
    <h1>Роботи, що<br/>працюють.</h1>
    <div class="page-hero-bottom"><p>Продукти, створені під реальну задачу: пояснити пропозицію, прибрати тертя або зробити процес кращим.</p><p>{projects.length.toString().padStart(2, '0')} проєкти / Архів зростає</p></div>
  </section>
  <section class="work-index">
    <div class="filters" role="group" aria-label="Фільтрувати проєкти" data-filters>
      {categories.map((category, index) => <button class:list={['filter-button', { active: index === 0 }]} type="button" data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}
    </div>
    <div aria-live="polite" data-project-list>
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>
</BaseLayout>
