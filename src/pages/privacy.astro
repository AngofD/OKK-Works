---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/content/site';
---
<BaseLayout title="Privacy">
  <section class="privacy-page"><p class="eyebrow">Legal / Placeholder</p><h1>Privacy.</h1><div class="privacy-copy"><p>This is a concise placeholder pending a jurisdiction-specific privacy policy. The current static site does not set marketing cookies or store form submissions.</p><h2>Project inquiries</h2><p>The inquiry form prepares an email in your local email application. Information is only sent when you choose to send that email.</p><h2>Contact</h2><p>For privacy questions, contact <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.</p></div></section>
</BaseLayout>
