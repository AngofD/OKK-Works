---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/content/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noFooter?: boolean;
}

const {
  title = 'Digital products that work',
  description = site.description,
  image = '/og-cover.png',
  noFooter = false,
} = Astro.props;
const fullTitle = title === 'Digital products that work' ? `${site.name} - ${title}` : `${title} - ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  description: site.description,
  email: site.email,
  knowsAbout: ['Web development', 'Telegram bot development', 'Business automation'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#11110f" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <title>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-progress" aria-hidden="true"><span data-progress></span></div>
    <Header />
    <main id="main"><slot /></main>
    {!noFooter && <Footer />}
    <script>
      import '@/lib/site';
    </script>
  </body>
</html>
